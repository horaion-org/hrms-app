VITE_APP_ENVIRONMENT="development"

# Base URL of the Horaion API. No trailing slash.
VITE_API_BASE_URL="http://api.horaion.localhost"

# Sign-in goes through the API (ADR 0005); the app needs no Cognito settings.
# The app and the API must share a registrable domain so the API's
# SameSite=Strict Session cookie is sent.
