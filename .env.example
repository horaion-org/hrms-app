VITE_APP_ENVIRONMENT="development"

# Base URL of the Horaion API. No trailing slash.
VITE_API_BASE_URL="http://api.horaion.localhost"

# Cognito user pool backing the API. The app client must be public (no client
# secret) with ALLOW_USER_SRP_AUTH enabled, because SRP cannot compute a
# SECRET_HASH. These values are public by design and ship in the bundle.
VITE_COGNITO_REGION=""
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_CLIENT_ID=""
