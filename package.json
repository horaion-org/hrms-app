    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prop-types": "^15.8.1",
    "solid-js": "^1.9.15",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
