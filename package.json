{
  "name": "horaion-app",
  "author": "Vernon Wee Hong KOH <vernonweehongkoh.developer@gmail.com>",
  "description": "Horaion people, scheduling, and leave management",
  "keywords": [
    "horaion",
    "hr",
    "scheduling",
    "leave"
  ],
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "git init && npx playwright install",
    "format": "prettier \"src/**/*.{ts,tsx}\" --write",
    "generate:icons": "node src/components/ui/Icon/generator/generate.mjs",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --max-warnings 0 --fix",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "storybook:setup": "node node_modules/@storybook/addon-styling/bin/postinstall.js",
    "storybook:build": "storybook build",
    "test": "vitest run src/ && playwright test",
    "test:unit": "vitest src/",
    "test:unit:coverage": "vitest --coverage src/",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.1",
