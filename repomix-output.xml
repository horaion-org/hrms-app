		</I18nextProvider>
	);
};

/** Each card's rows as "label: value". */
const rows = (card: string): Array<string> =>
	within(screen.getByRole("region", { name: card }))
		.getAllByRole("term")
		.map(
			(term) => `${term.textContent}: ${term.nextElementSibling?.textContent}`
