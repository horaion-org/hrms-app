it.each([
	{ accessToken: "", expiresIn: 900 },
	{ accessToken: "x", expiresIn: -1 },
	{ challenge: "SMS_MFA" },
	{ accessToken: "x", expiresIn: 900, challenge: "SOFTWARE_TOKEN_MFA" },
