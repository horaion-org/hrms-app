const pageReply = (
	content: Array<Record<string, unknown>>,
	totalElements = content.length
): StubReply => ({
	status: 200,
	body: envelope({ content, page: { totalElements } }),
});

const branch = (
	branchId: string,
	name: string,
	status = "ACTIVE"
): Record<string, unknown> => ({
	branchId,
	companyId: "c-1",
	name,
	code: "SG-ORC-01",
	city: "Singapore",
	country: "SG",
	status,
	headMembershipIds: [],
});

const jobTitle = (
	jobTitleId: string,
	name: string,
	status = "ACTIVE"
): Record<string, unknown> => ({
	jobTitleId,
	companyId: "c-1",
	branchId: "b-1",
	branchName: "Orchard",
	departmentId: "d-1",
	departmentName: "Kitchen",
	name,
	status,
});

const department = (
	departmentId: string,
	name: string,
	status = "ACTIVE"
): Record<string, unknown> => ({
	departmentId,
	branchId: "b-1",
	companyId: "c-1",
	name,
	status,
	headMembershipIds: [],
});

const baseRoutes = (
	permissions = EVERY_PERMISSION
): Record<string, StubReply> => ({
	[REFRESH]: accessPassReply(),
	[ME]: currentUserReply(),
	[WORKSPACE]: workspaceReply(permissions),
});

const bodyRows = (table: HTMLElement): Array<HTMLElement> =>
	within(table).getAllByRole("row").slice(1);

const searchesOf = (
	calls: Array<{ path: string; search: string }>,
	path: string
): Array<string> =>
	calls.filter((call) => call.path === path).map((call) => call.search);

