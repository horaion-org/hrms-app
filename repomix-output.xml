<file path="src/components/forms/Combobox/Combobox.tsx">
import {
	Combobox as HeadlessCombobox,
	ComboboxButton,
	ComboboxInput,
	ComboboxOption,
	ComboboxOptions,
} from "@headlessui/react";
import {
	Fragment,
	useCallback,
	useId,
	useRef,
	type AriaAttributes,
	type ReactNode,
	type Ref,
	type RefObject,
} from "react";
import { useTranslation } from "react-i18next";
import { joinClassNames } from "@/common/joinClassNames";
import type { FunctionComponent } from "@/common/types";
import type { InputStatus } from "@/components/forms/Input";
import { ComboboxTrigger } from "@/components/forms/Combobox/ComboboxTrigger";
import { ComboboxPanel } from "@/components/forms/Combobox/ComboboxPanel";
import { ComboboxSearch } from "@/components/forms/Combobox/ComboboxSearch";
import { Token } from "@/components/forms/Combobox/Token";
import {
	CheckboxFilledIcon,
	CheckboxIcon,
	ChevronDownIcon,
} from "@/components/ui/Icon";

type ComboboxSelectionProps<T> =
	| {
			multiple?: true;
			value: Array<T>;
			onChange: (value: Array<T>) => void;
			maxSelected?: number;
	  }
	| {
			multiple: false;
			value: T | null;
			onChange: (value: T | null) => void;
			maxSelected?: never;
	  };

export type ComboboxProps<T> = ComboboxSelectionProps<T> & {
	options: Array<T>;
	getKey: (option: T) => string;
	getLabel: (option: T) => string;
	/** Single choice: the trigger's text for the chosen option; defaults to `getLabel`. */
	formatValue?: (option: T) => string;
	renderOption?: (option: T) => ReactNode;
	query: string;
	onQueryChange: (query: string) => void;
	loading?: boolean;
	loadingText?: string;
	emptyText?: string;
	footer?: ReactNode;
	/** Places the list under this element, e.g. a wider field the trigger sits in, instead of the trigger. */
	panelAnchor?: RefObject<HTMLElement | null>;
	placeholder: string;
	searchPlaceholder: string;
	status?: InputStatus;
	disabled?: boolean;
	id?: string;
	className?: string;
	ref?: Ref<HTMLButtonElement>;
	"aria-label"?: string;
	"aria-labelledby"?: string;
	"aria-describedby"?: string;
	"aria-invalid"?: AriaAttributes["aria-invalid"];
	"aria-required"?: AriaAttributes["aria-required"];
};

export const Combobox = <T,>(props: ComboboxProps<T>): FunctionComponent => {
	const { t } = useTranslation();
	const trigger = useRef<HTMLButtonElement>(null);
	const listId = useId();
	const tabbing = useRef(false);
	const focusSearch = useCallback((element: HTMLInputElement | null): void => {
		element?.focus();
	}, []);
	const { options, getKey, getLabel, query, onQueryChange, disabled } = props;
	const values = props.multiple === false ? [] : props.value;
	const rootProps = {
		as: "div" as const,
		by: (a: T | null, b: T | null): boolean =>
			a === null || b === null ? a === b : getKey(a) === getKey(b),
		disabled,
		onClose: (): void => {
			if (!tabbing.current)
				requestAnimationFrame(() => {
					trigger.current?.focus();
				});
			tabbing.current = false;
		},
	};
	const validation = {
		"aria-invalid":
			props["aria-invalid"] ?? (props.status === "error" ? true : undefined),
	};
	const statusClasses: Record<InputStatus, string> = {
		error: "border-error-600",
		success: "border-success-600",
	};
	const renderControl = ({
		open,
	}: {
		open: boolean;
	}): NonNullable<FunctionComponent> => (
		<>
			<div
				className={joinClassNames(
					"relative min-h-11 rounded-lg border px-4 py-2 text-sm focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ink-blue-500",
					disabled
						? "cursor-not-allowed border-neutral-400 bg-neutral-200 text-neutral-500"
						: joinClassNames(
								"bg-white text-ink-blue-900",
								props.status
									? statusClasses[props.status]
									: "border-neutral-400 focus-within:border-ink-blue-900"
							),
					props.className
				)}
			>
				<ComboboxButton
					ref={(element) => {
						trigger.current = element;
						if (typeof props.ref === "function") return props.ref(element);
						if (props.ref) props.ref.current = element;
					}}
					aria-required={props["aria-required"]}
					as={ComboboxTrigger}
					labelledBy={props["aria-labelledby"]}
					listId={listId}
					{...validation}
					aria-controls={open ? listId : undefined}
					aria-describedby={props["aria-describedby"]}
					aria-label={props["aria-label"]}
					aria-labelledby={props["aria-labelledby"]}
					className="absolute inset-0 flex w-full items-center justify-between gap-3 px-4 text-left"
					id={props.id}
					type="button"
					onKeyDown={(event) => {
						if (
							props.multiple === false &&
							props.value !== null &&
							!disabled &&
							event.key === "Backspace" &&
							!event.nativeEvent.isComposing
						) {
							event.preventDefault();
							props.onChange(null);
						}
					}}
				>
					<span>
						{props.multiple === false
							? props.value === null
								? props.placeholder
								: (props.formatValue ?? getLabel)(props.value)
							: values.length === 0
								? props.placeholder
								: null}
					</span>
					<ChevronDownIcon className="size-5 shrink-0" />
				</ComboboxButton>
				{props.multiple !== false && values.length > 0 && (
					<div className="pointer-events-none relative flex flex-wrap gap-1.5 pr-6 [&_button]:pointer-events-auto">
						{values.map((option) => (
							<Token
								key={getKey(option)}
								disabled={disabled}
								label={getLabel(option)}
								onRemove={() => {
									props.onChange(
										values.filter((chosen) => getKey(chosen) !== getKey(option))
									);
									trigger.current?.focus();
								}}
							/>
						))}
					</div>
				)}
			</div>
			<ComboboxOptions
				portal
				as={ComboboxPanel}
				className="flex flex-col overflow-hidden rounded-lg border border-neutral-400 bg-white shadow-sm"
				modal={false}
				trigger={props.panelAnchor ?? trigger}
			>
				<ComboboxInput as={Fragment}>
					<ComboboxSearch
						ref={focusSearch}
						aria-controls={listId}
						aria-label={props.searchPlaceholder}
						className="h-11 w-full shrink-0 border-b border-neutral-300 px-4 outline-hidden"
						listId={listId}
						placeholder={props.searchPlaceholder}
						value={query}
						onChange={(event) => {
							onQueryChange(event.target.value);
						}}
						onKeyDown={(event) => {
							if (event.key === "Tab") {
								tabbing.current = true;
								trigger.current?.focus();
							}
							if (
								event.key === " " &&
								query === "" &&
								!event.nativeEvent.isComposing
							) {
								const activeId = event.currentTarget.getAttribute(
									"aria-activedescendant"
								);
								const active = activeId
									? event.currentTarget.ownerDocument.getElementById(activeId)
									: null;
								if (active && active.getAttribute("aria-disabled") !== "true") {
									event.preventDefault();
									event.currentTarget.dispatchEvent(
										new KeyboardEvent("keydown", {
											key: "Enter",
											bubbles: true,
											cancelable: true,
										})
									);
								}
							}
							if (
								event.key === "Backspace" &&
								query === "" &&
								props.multiple !== false &&
								values.length > 0 &&
								!event.nativeEvent.isComposing
							) {
								event.preventDefault();
								props.onChange(values.slice(0, -1));
							}
						}}
					/>
				</ComboboxInput>
				<div
					aria-label={props["aria-label"]}
					aria-labelledby={props["aria-labelledby"]}
					aria-multiselectable={props.multiple === false ? undefined : true}
					className="min-h-0 max-h-60 overflow-y-auto py-1"
					id={listId}
					role="listbox"
				>
					{options.map((option) => (
						<ComboboxOption
							key={getKey(option)}
							aria-label={getLabel(option)}
							className="flex min-h-12 cursor-pointer items-center gap-3 px-4 text-sm data-focus:bg-neutral-100 data-disabled:cursor-not-allowed data-disabled:text-neutral-500"
							value={option}
							disabled={
								props.maxSelected !== undefined &&
								values.length >= props.maxSelected &&
								!values.some((chosen) => getKey(chosen) === getKey(option))
							}
						>
							{({ selected }) => (
								<>
									<span className="min-w-0 flex-1">
										{props.renderOption?.(option) ?? getLabel(option)}
									</span>
									{selected ? (
										<CheckboxFilledIcon className="size-5" />
									) : (
										<CheckboxIcon className="size-5" />
									)}
								</>
							)}
						</ComboboxOption>
					))}
				</div>
				{(props.loading || options.length === 0) && (
					<div className="px-4 py-3 text-sm text-neutral-500" role="status">
						{props.loading
							? (props.loadingText ?? t("combobox.loading"))
							: (props.emptyText ?? t("combobox.noResults"))}
					</div>
				)}
				{props.footer && (
					<div className="border-t border-neutral-300 px-4 py-3 text-xs text-neutral-500">
						{props.footer}
					</div>
				)}
			</ComboboxOptions>
		</>
	);
	return props.multiple === false ? (
		<HeadlessCombobox<T | null, false, "div">
			{...rootProps}
			value={props.value}
			onChange={props.onChange}
		>
			{renderControl}
		</HeadlessCombobox>
	) : (
		<HeadlessCombobox<Array<T>, true, "div">
			{...rootProps}
			multiple
			value={props.value}
			onChange={(next) => {
				if (
					disabled ||
					(props.maxSelected !== undefined &&
						next.length > props.maxSelected &&
						next.length > props.value.length)
				)
					return;
				props.onChange(next);
			}}
		>
			{renderControl}
		</HeadlessCombobox>
	);
};
</file>

<file path="src/components/forms/PhoneInput/PhoneInput.tsx">
import {
	useMemo,
	useRef,
	useState,
	type AriaAttributes,
	type FocusEventHandler,
	type Ref,
} from "react";
import { useTranslation } from "react-i18next";
import { joinClassNames } from "@/common/joinClassNames";
import type { FunctionComponent } from "@/common/types";
import { Combobox } from "@/components/forms/Combobox";
import { Input, type InputStatus } from "@/components/forms/Input";
import { callingCodes } from "@/components/forms/PhoneInput/callingCodes";
import {
	formatPhone,
	parsePhone,
	type PhoneParts,
} from "@/components/forms/PhoneInput/PhoneInput.utils";
import { countryCodes, countryName } from "@/common/countries";

export type PhoneInputProps = {
	/** E.164, such as "+6583247931", or "" when no number is entered. */
	value: string;
	onChange: (value: string) => void;
	/** ISO 3166-1 alpha-2 region chosen while the field is empty, such as "SG". */
	defaultCountry?: string;
	/** For the number box, such as "8123 4567". */
	placeholder?: string;
	status?: InputStatus;
	disabled?: boolean;
	/** Set on the number box, so a FormRow label and `ref` focus it. */
	id?: string;
	name?: string;
	className?: string;
	ref?: Ref<HTMLInputElement>;
	onBlur?: FocusEventHandler<HTMLInputElement>;
	"aria-labelledby"?: string;
	"aria-describedby"?: string;
	"aria-invalid"?: AriaAttributes["aria-invalid"];
	"aria-required"?: AriaAttributes["aria-required"];
};

type Country = { code: string; name: string; callingCode: string };

/** A country calling code and a national number, reported together as one E.164 value. */
export const PhoneInput = ({
	value,
	onChange,
	defaultCountry,
	placeholder,
	status,
	disabled,
	id,
	name,
	className,
	ref,
	onBlur,
	"aria-labelledby": ariaLabelledby,
	"aria-describedby": ariaDescribedby,
	"aria-invalid": ariaInvalid,
	"aria-required": ariaRequired,
}: PhoneInputProps): FunctionComponent => {
	const { t, i18n } = useTranslation();
	const group = useRef<HTMLDivElement>(null);
	const [query, setQuery] = useState("");
	const [parts, setParts] = useState(() => parsePhone(value, defaultCountry));
	// The shown parts are re-read only when the value changes from outside,
	// so a typed space or a chosen country that shares a code survives.
	const [seenValue, setSeenValue] = useState(value);
	if (value !== seenValue) {
		setSeenValue(value);
		if (value !== formatPhone(parts))
			setParts(parsePhone(value, defaultCountry));
	}
	// A default that arrives or changes later is adopted until the person
	// chooses a country or types a number.
	const [chose, setChose] = useState(false);
	const [seenDefault, setSeenDefault] = useState(defaultCountry);
	if (defaultCountry !== seenDefault) {
		setSeenDefault(defaultCountry);
		if (!chose && parts.national === "")
			setParts(parsePhone("", defaultCountry));
	}
	const countries = useMemo(
		() =>
			countryCodes
				.flatMap((code): Array<Country> => {
					const callingCode = callingCodes[code];
					return callingCode
						? [{ code, name: countryName(code, i18n.language), callingCode }]
						: [];
				})
				.sort((a, b) => a.name.localeCompare(b.name, i18n.language)),
		[i18n.language]
	);
	const search = query.trim().toLocaleLowerCase(i18n.language);
	// Digits, with or without "+", search by code; anything else by name.
	const codeSearch = /^\+?\d*$/.test(search) ? search.replace("+", "") : null;
	const chosen = countries.find((country) => country.code === parts.region);
	const update = (next: PhoneParts): void => {
		setParts(next);
		const nextValue = formatPhone(next);
		if (nextValue !== value) onChange(nextValue);
	};
	return (
		<div
			ref={group}
			aria-labelledby={ariaLabelledby}
			className={joinClassNames("flex gap-3", className)}
			role="group"
		>
			<Combobox
				aria-describedby={ariaDescribedby}
				className="w-28 shrink-0"
				disabled={disabled}
				formatValue={(country) => country.callingCode}
				getKey={(country) => country.code}
				getLabel={(country) => `${country.name} ${country.callingCode}`}
				multiple={false}
				panelAnchor={group}
				placeholder={t("phoneInput.countryPlaceholder")}
				query={query}
				searchPlaceholder={t("phoneInput.searchCountries")}
				status={status}
				value={chosen ?? null}
				aria-label={
					chosen
						? t("phoneInput.countryCodeValue", {
								country: `${chosen.name} ${chosen.callingCode}`,
							})
						: t("phoneInput.countryCode")
				}
				options={countries.filter((country) =>
					codeSearch === null
						? country.name.toLocaleLowerCase(i18n.language).includes(search)
						: country.callingCode.slice(1).startsWith(codeSearch)
				)}
				renderOption={(country) => (
					<span className="flex items-center justify-between gap-3">
						<span className="min-w-0">{country.name}</span>
						<span className="shrink-0 text-neutral-600">
							{country.callingCode}
						</span>
					</span>
				)}
				onQueryChange={setQuery}
				onChange={(country) => {
					setChose(true);
					update({ ...parts, region: country?.code ?? null });
				}}
			/>
			<Input
				ref={ref}
				aria-describedby={ariaDescribedby}
				aria-invalid={ariaInvalid}
				aria-label={ariaLabelledby ? undefined : t("phoneInput.number")}
				aria-labelledby={ariaLabelledby}
				aria-required={ariaRequired}
				autoComplete="tel-national"
				className="min-w-0 flex-1"
				disabled={disabled}
				id={id}
				inputMode="tel"
				name={name}
				placeholder={placeholder}
				status={status}
				type="tel"
				value={parts.national}
				onBlur={onBlur}
				onChange={(event) => {
					// Only digits and spaces are kept; spaces never reach the value.
					update({
						...parts,
						national: event.target.value.replace(/[^\d ]/g, ""),
					});
				}}
			/>
		</div>
	);
};
</file>

