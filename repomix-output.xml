<file path="src/features/auth/challenge.ts">
import type { TFunction } from "i18next";
import { z } from "zod";
import { returnPath } from "@/features/auth/returnPath";
import type { ChallengeKind } from "@/features/auth/session";

export function challengePath(kind: ChallengeKind): "/new-password" | "/mfa" {
	switch (kind) {
		case "NEW_PASSWORD_REQUIRED":
			return "/new-password";
		case "SOFTWARE_TOKEN_MFA":
			return "/mfa";
		default: {
			const exhaustive: never = kind;
			return exhaustive;
		}
	}
}

const searchSchema = z.object({
	redirect: z.string().optional().catch(undefined),
});
export function challengeSearch(search: unknown): { redirect?: string } {
	const parsed = searchSchema.parse(search);
	return parsed.redirect === undefined
		? {}
		: { redirect: returnPath(parsed.redirect) };
}

export type NewPasswordValues = {
	newPassword: string;
	confirmPassword: string;
};
export function newPasswordFormSchema(
	t: TFunction
): z.ZodType<NewPasswordValues, NewPasswordValues> {
	return z
		.object({
			newPassword: z
				.string()
				.min(8, t("auth.challenge.passwordPolicy"))
				.max(128, t("auth.challenge.passwordPolicy"))
				.refine(
					(value) =>
						/[a-z]/.test(value) &&
						/[A-Z]/.test(value) &&
						/\d/.test(value) &&
						/[^a-zA-Z0-9\s]/.test(value),
					t("auth.challenge.passwordPolicy")
				),
			confirmPassword: z.string(),
		})
		.refine((values) => values.newPassword === values.confirmPassword, {
			path: ["confirmPassword"],
			message: t("auth.challenge.passwordMismatch"),
		});
}

export type AuthenticatorCodeValues = { code: string };
export function authenticatorCodeSchema(
	t: TFunction
): z.ZodType<AuthenticatorCodeValues, AuthenticatorCodeValues> {
	return z.object({
		code: z.string().regex(/^\d{6}$/, t("auth.challenge.codeFormat")),
	});
}
</file>

<file path="src/features/auth/connectSession.ts">
import type { QueryClient } from "@tanstack/react-query";
import type { AnyRouter } from "@tanstack/react-router";
import { configureApiClient } from "@/common/api-client";
import {
	accessToken,
	endSession,
	hasAccessPass,
	onSessionEnded,
	renewSession,
} from "@/features/auth/session";

export function connectSession(
	router: AnyRouter,
	queryClient: QueryClient
): () => void {
	let resettling: Promise<void> | undefined;
	configureApiClient({
		accessToken,
		onMembershipRevoked: (path) => {
			// The guard handles /me refusals itself; invalidating it here would loop.
			if (
				resettling ||
				(path === "/api/v1/me" &&
					queryClient.getQueryState(["me"])?.fetchStatus === "fetching")
			)
				return;
			queryClient.removeQueries({ queryKey: ["me"], exact: true });
			resettling = router.invalidate().finally(() => {
				resettling = undefined;
			});
		},
		renew: renewSession,
		onUnauthenticated: () => {
			if (hasAccessPass()) endSession("expired");
		},
	});
	return onSessionEnded((reason) => {
		queryClient.clear();
		const guarded = router.state.matches.some((match) =>
			match.routeId.startsWith("/_authenticated")
		);
		if (!guarded && reason === "expired") return;
		void router.navigate({
			to: "/login",
			replace: true,
			search:
				reason === "expired" ? { redirect: router.state.location.href } : {},
		});
	});
}
</file>

