<file path="src/features/people/skills.ts">
import type { TFunction } from "i18next";
import { z } from "zod";
import { ApiProblemError } from "@/common/problem";
import { unitNameSchema } from "@/features/organisation/createSchemas";
import { mapRefusal, type Refusal } from "@/features/organisation/refusal";
import type { CompanySkill, SkillValue } from "@/features/people/api";
import { PROFILE_REFUSAL_CODES } from "@/features/people/profileRefusal";

/** The most skills one person may have. */
export const MAX_SKILLS = 50;

/** Proficiency runs from 1, a beginner, to 10, an expert. */
export const PROFICIENCY_MIN = 1;
export const PROFICIENCY_MAX = 10;

/** Where a skill picked in the dialog starts. */
export const DEFAULT_PROFICIENCY = 5;

/** Skill names match ignoring case, as the API matches them. */
const sameName = (a: string, b: string): boolean =>
	a.trim().toLocaleLowerCase() === b.trim().toLocaleLowerCase();

/** Whether two sets of skills hold the same names at the same proficiency, in any order. */
export const sameSkills = (
	a: ReadonlyArray<SkillValue>,
	b: ReadonlyArray<SkillValue>
): boolean =>
	a.length === b.length &&
	a.every((skill) =>
		b.some(
			(other) =>
				sameName(other.name, skill.name) &&
				other.proficiency === skill.proficiency
		)
	);

/** `skills` with `added`, in name order as the API lists them. */
export const withSkill = (
	skills: ReadonlyArray<SkillValue>,
	added: SkillValue
): Array<SkillValue> =>
	[...skills, added].sort((a, b) =>
		a.name.localeCompare(b.name, undefined, { sensitivity: "base" })
	);

/** One choice in the skill picker: a name the company uses, or the one typed. */
export type SkillChoice = { name: string; isNew: boolean };

/**
 * The picker's choices: what was typed, as a new name, unless the company
 * already uses it, then the company's names that matched.
 */
export const skillChoices = (
	suggestions: ReadonlyArray<CompanySkill>,
	query: string
): Array<SkillChoice> => {
	const typed = query.trim();
	const existing = suggestions.map(({ name }) => ({ name, isNew: false }));
	return typed && !suggestions.some(({ name }) => sameName(name, typed))
		? [{ name: typed, isNew: true }, ...existing]
		: existing;
};

/**
 * A skill as the dialog adds it: a valid name the person doesn't have yet,
 * while they have room for another, and a proficiency from 1 to 10.
 */
export const skillFormSchema = (
	t: TFunction,
	/** The names they already have. */
	taken: ReadonlyArray<string>
): z.ZodObject<{ name: z.ZodString; proficiency: z.ZodNumber }> => {
	const key = "people.skills.dialog";
	return z.object({
		name: unitNameSchema({
			required: t(`${key}.nameRequired`),
			length: t(`${key}.nameLength`),
			characters: t(`${key}.nameCharacters`),
		})
			.refine((name) => !taken.some((other) => sameName(other, name)), {
				message: t(`${key}.nameTaken`),
			})
			.refine(() => taken.length < MAX_SKILLS, {
				message: t(`${key}.tooMany`),
			}),
		proficiency: z
			.number()
			.int()
			.min(PROFICIENCY_MIN, t(`${key}.proficiencyRejected`))
			.max(PROFICIENCY_MAX, t(`${key}.proficiencyRejected`)),
	});
};

export type SkillFormValues = z.infer<ReturnType<typeof skillFormSchema>>;

export type SkillField = "name" | "proficiency";

/**
 * Why saving a person's skills was refused, read for the skill at `row` of
 * the set sent: its own field errors land on its fields; a refusal of
 * another row, someone else's change at the same moment, and the rest are
 * the dialog's alert. Server codes select frontend-owned copy only.
 */
export const skillsRefusal = (
	error: unknown,
	t: TFunction,
	row: number
): Refusal<SkillField> => {
	const key = "people.skills.dialog";
	const moved =
		error instanceof ApiProblemError &&
		`${error.status} ${error.errorCode}` === PROFILE_REFUSAL_CODES.profileMoved;
	// A plain 409, or SKILL_NAME_CONFLICT: both mean someone else changed them.
	if (error instanceof ApiProblemError && error.status === 409 && !moved)
		return { fields: {}, message: t(`${key}.conflict`), refreshMembers: false };
	const refusal = mapRefusal<SkillField>(error, {
		codes: {
			"400 DUPLICATE_SKILL_NAME": {
				field: "name",
				message: t(`${key}.nameTaken`),
			},
			"400 INVALID_SKILL_NAME": {
				field: "name",
				message: t(`${key}.nameRejected`),
			},
		},
		alerts: {
			[PROFILE_REFUSAL_CODES.profileNotFound]: t("people.form.profileMissing"),
			[PROFILE_REFUSAL_CODES.profileMoved]: t("people.profile.moved"),
		},
		fieldErrors: {
			[`skills[${row}].name`]: {
				field: "name",
				message: t(`${key}.nameRejected`),
			},
			[`skills[${row}].proficiency`]: {
				field: "proficiency",
				message: t(`${key}.proficiencyRejected`),
			},
		},
		forbidden: t(`${key}.forbidden`),
		failed: t(`${key}.failed`),
	});
	// Field errors that name only the skills they already had.
	if (
		error instanceof ApiProblemError &&
		error.status === 400 &&
		error.fieldErrors.length > 0 &&
		Object.keys(refusal.fields).length === 0
	)
		return { ...refusal, message: t(`${key}.otherRejected`) };
	return refusal;
};
</file>

<file path="src/features/people/useEditProfile.ts">
import { useMutation, useQueryClient } from "@tanstack/react-query";
import { useNavigate } from "@tanstack/react-router";
import { useChangeAccessRoleHolders } from "@/features/organisation/useAccessRoleHolders";
import {
	memberProfileQuery,
	updateMemberProfile,
	type MemberProfileDetail,
	type MemberProfilePlace,
	type SkillValue,
	type UpdateMemberProfileBody,
} from "@/features/people/api";
import {
	departmentRoleChange,
	type MemberRole,
} from "@/features/people/memberRoles";
import { withPeopleNotice } from "@/features/people/peopleNoticeState";
import type { ProfileFormValues } from "@/features/people/profileFormSchema";
import { profileUpdateRequest } from "@/features/people/profileRequest";
import { useReplaceSkills } from "@/features/people/useSkills";

/**
 * Saves a person's profile, in the Department chosen for them. Then, when
 * `role` is given, it changes the system role at that Department, then
 * shows their profile again with a notice saying so. A refused save rejects
 * for the form to explain. A refused role does not: the profile is saved, so
 * the notice says so and that the role still needs changing. Given
 * `skills`, the complete new set is then sent, and a refusal of it is said
 * in the notice the same way.
 */
export const useEditProfile = (
	companyId: string,
	profile: MemberProfileDetail,
	/** The role held at their Department before saving; left out when roles can't be changed here. */
	role: { held: MemberRole | undefined } | undefined,
	/** Their skills as changed on the page; left out when unchanged or not changeable here. */
	skills?: ReadonlyArray<SkillValue>
): ((
	values: ProfileFormValues,
	place: MemberProfilePlace
) => Promise<void>) => {
	const client = useQueryClient();
	const navigate = useNavigate();
	const { membershipId } = profile;
	const save = useMutation({
		mutationFn: (body: UpdateMemberProfileBody) =>
			updateMemberProfile(companyId, membershipId, body),
		onSuccess: (saved) => {
			client.setQueryData<MemberProfileDetail>(
				memberProfileQuery(companyId, membershipId).queryKey,
				() => saved
			);
			return Promise.all([
				client.invalidateQueries({ queryKey: ["people", companyId] }),
				client.invalidateQueries({
					queryKey: ["organisation", companyId, "members"],
				}),
			]);
		},
	});
	const assign = useChangeAccessRoleHolders(companyId);
	const replaceSkills = useReplaceSkills(companyId, membershipId);
	return async (values, place) => {
		const saved = await save.mutateAsync(
			profileUpdateRequest({
				...values,
				status: values.status ?? profile.status,
			})
		);
		const change =
			role &&
			departmentRoleChange({
				membershipId,
				held: role.held,
				chosen: values.accessRoleId,
				place,
			});
		let roleNotAssigned = false;
		if (change)
			try {
				// Granted before the old one goes, so a refusal leaves the role as it was.
				await assign.mutateAsync({ grants: change.grants });
				await assign.mutateAsync({ revokes: change.revokes });
			} catch {
				roleNotAssigned = true;
			}
		let skillsNotSaved = false;
		if (skills)
			try {
				await replaceSkills.mutateAsync(skills);
			} catch {
				skillsNotSaved = true;
			}
		await navigate({
			to: "/people/$membershipId",
			params: { membershipId },
			search: {},
			replace: true,
			state: withPeopleNotice({
				kind: "saved",
				name: saved.displayName,
				roleNotAssigned,
				...(skillsNotSaved && { skillsNotSaved }),
			}),
		});
	};
};
</file>

<file path="src/features/people/useMemberRoles.ts">
import { skipToken, useQuery } from "@tanstack/react-query";
import { ApiProblemError } from "@/common/problem";
import { fetchMemberAccessRoleAssignments } from "@/features/organisation/api";
import { useAccessRoles } from "@/features/organisation/useOrganisationList";
import { memberRoles, type MemberRoles } from "@/features/people/memberRoles";
import { retry } from "@/features/workspace/retry";
import { useCan } from "@/features/workspace/useCan";

const BY_NAME = { sort: { field: "name", desc: false } } as const;

/**
 * The system roles a person holds. Roles have no unit, so reading them needs
 * the key company-wide; without it, or when the API refuses with a 403, they
 * are `hidden`.
 */
export const useMemberRoles = (
	companyId: string,
	membershipId: string
): MemberRoles => {
	const allowed = useCan()("access_role:read");
	// Inside the Organisation entries, so assigning or removing a role reloads it.
	const assignments = useQuery({
		queryKey: ["organisation", companyId, "member-assignments", membershipId],
		queryFn: allowed
			? (): ReturnType<typeof fetchMemberAccessRoleAssignments> =>
					fetchMemberAccessRoleAssignments(companyId, membershipId)
			: skipToken,
		retry,
	});
	const roles = useAccessRoles(companyId, BY_NAME);

	if (!allowed) return { status: "hidden" };
	if (
		assignments.error instanceof ApiProblemError &&
		assignments.error.status === 403
	)
		return { status: "hidden" };
	if (assignments.isError) return { status: "error" };
	if (roles.status !== "ready") return { status: roles.status };
	if (assignments.data === undefined) return { status: "pending" };
	return { status: "ready", roles: memberRoles(assignments.data, roles.items) };
};
</file>

<file path="src/features/people/useNotes.ts">
import {
	useInfiniteQuery,
	useMutation,
	useQueryClient,
	type InfiniteData,
	type UseInfiniteQueryResult,
	type UseMutationResult,
} from "@tanstack/react-query";
import type { ListPage } from "@/features/organisation/api";
import {
	createMemberNote,
	deleteMemberNote,
	memberNotesQuery,
	updateMemberNote,
	type MemberNote,
} from "@/features/people/api";

/** A person's notes, a page at a time; `allowed` false asks for nothing. */
export const useMemberNotes = (
	companyId: string,
	membershipId: string,
	allowed: boolean
): UseInfiniteQueryResult<InfiniteData<ListPage<MemberNote>>> =>
	useInfiniteQuery({
		...memberNotesQuery(companyId, membershipId),
		enabled: allowed,
	});

/** Reloads every page of the notes, so the list and its count stay right after any change. */
const useReloadNotes = (
	companyId: string,
	membershipId: string
): (() => Promise<void>) => {
	const client = useQueryClient();
	return () =>
		client.invalidateQueries({
			queryKey: memberNotesQuery(companyId, membershipId).queryKey,
		});
};

/** Adds a note, or with `noteId` rewrites one. */
export const useSaveNote = (
	companyId: string,
	membershipId: string
): UseMutationResult<
	MemberNote,
	Error,
	{ noteId: string | undefined; body: string }
> => {
	const reload = useReloadNotes(companyId, membershipId);
	return useMutation({
		mutationFn: ({ noteId, body }) =>
			noteId
				? updateMemberNote(companyId, membershipId, noteId, body)
				: createMemberNote(companyId, membershipId, body),
		// A refusal may mean the note is gone, so the list reloads either way.
		onSettled: reload,
	});
};

/** Deletes a note. */
export const useDeleteNote = (
	companyId: string,
	membershipId: string
): UseMutationResult<void, Error, string> => {
	const reload = useReloadNotes(companyId, membershipId);
	return useMutation({
		mutationFn: (noteId) => deleteMemberNote(companyId, membershipId, noteId),
		onSettled: reload,
	});
};
</file>

