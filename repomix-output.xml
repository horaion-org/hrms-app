	opened.queryClient.clear();
	endSession("expired");
	app = await openApp("/");
	const match = app.router.state.matches.find(
		(item) => item.routeId === "/_authenticated"
	);
	expect(match?.context).toMatchObject({
		currentCompany: { kind: "settled", company: { companyId: "b" } },
	});
