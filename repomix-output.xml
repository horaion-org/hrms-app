<file path="src/features/organisation/activity.ts">
import type { TFunction } from "i18next";
import type { Heroicon } from "@/common/types";
import {
	DepartmentIcon,
	OrganisationIcon,
	PermissionsIcon,
	RoleIcon,
	UserIcon,
} from "@/components/ui/Icon";
import type { AuditEvent } from "@/features/organisation/api";

type ActivityKey =
	| "branchCreated"
	| "branchUpdated"
	| "departmentCreated"
	| "departmentUpdated"
	| "jobTitleCreated"
	| "jobTitleUpdated"
	| "roleCreated"
	| "roleUpdated"
	| "roleDeleted";

const ACTIVITIES: Record<string, { key: ActivityKey; icon: Heroicon }> = {
	"branch.create": { key: "branchCreated", icon: OrganisationIcon },
	"branch.update": { key: "branchUpdated", icon: OrganisationIcon },
	"department.create": { key: "departmentCreated", icon: DepartmentIcon },
	"department.update": { key: "departmentUpdated", icon: DepartmentIcon },
	"job_title.create": { key: "jobTitleCreated", icon: RoleIcon },
	"job_title.update": { key: "jobTitleUpdated", icon: RoleIcon },
	"access_role.create": { key: "roleCreated", icon: UserIcon },
	"access_role.update": { key: "roleUpdated", icon: PermissionsIcon },
	"access_role.delete": { key: "roleDeleted", icon: UserIcon },
};

export type Activity = { id: string; icon: Heroicon; title: string };

/** How an audit event reads in Recent Activity; undefined for actions it doesn't describe. */
export const describeActivity = (
	event: AuditEvent,
	t: TFunction
): Activity | undefined => {
	const activity = ACTIVITIES[event.action];
	if (!activity) return undefined;
	const title =
		event.entityName === null
			? t(`organisation.activity.unnamed.${activity.key}`)
			: t(`organisation.activity.named.${activity.key}`, {
					name: event.entityName,
				});
	return { id: event.auditEventId, icon: activity.icon, title };
};

const UNITS: Array<{ unit: Intl.RelativeTimeFormatUnit; seconds: number }> = [
	{ unit: "year", seconds: 365 * 24 * 60 * 60 },
	{ unit: "month", seconds: 30 * 24 * 60 * 60 },
	{ unit: "week", seconds: 7 * 24 * 60 * 60 },
	{ unit: "day", seconds: 24 * 60 * 60 },
	{ unit: "hour", seconds: 60 * 60 },
	{ unit: "minute", seconds: 60 },
];

/**
 * "2 hours ago", "Yesterday", "5 days ago": the largest whole unit since
 * `occurredAt`, or undefined when it is under a minute ago (or in the future).
 */
export const timeAgo = (
	occurredAt: string,
	now: Date,
	locale: string
): string | undefined => {
	const elapsed = (now.getTime() - new Date(occurredAt).getTime()) / 1000;
	const match = UNITS.find(({ seconds }) => elapsed >= seconds);
	if (!match || Number.isNaN(elapsed)) return undefined;
	const text = new Intl.RelativeTimeFormat(locale, { numeric: "auto" }).format(
		-Math.floor(elapsed / match.seconds),
		match.unit
	);
	return text.charAt(0).toLocaleUpperCase(locale) + text.slice(1);
};
</file>

<file path="src/features/organisation/assignmentRefusal.ts">
import type { TFunction } from "i18next";
import { ApiProblemError } from "@/common/problem";
import { mapRefusal } from "@/features/organisation/refusal";

/** The API's stable codes for refusing to assign an access role. */
export const ASSIGNMENT_ERROR = {
	conflict: "ACCESS_ROLE_ASSIGNMENT_CONFLICT",
	invalid: "INVALID_ACCESS_ROLE_ASSIGNMENT",
	roleInactive: "ACCESS_ROLE_INACTIVE",
} as const;

/** Server codes select frontend-owned copy; untrusted server prose is never displayed. */
export const assignmentRefusal = (error: unknown, t: TFunction): string => {
	const key = "organisation.accessRoles.assignments.dialog";
	if (error instanceof ApiProblemError) {
		if (error.status === 409 && error.errorCode === ASSIGNMENT_ERROR.conflict)
			return t(`${key}.conflict`);
		if (error.status === 400 && error.errorCode === ASSIGNMENT_ERROR.invalid)
			return t(`${key}.notMember`);
		if (error.status === 403) return t(`${key}.forbidden`);
	}
	return t(`${key}.failed`);
};

/** Why one person's assignment could not be activated or deactivated, in the app's own words. */
export const assignmentStatusRefusal = (
	error: unknown,
	t: TFunction
): string => {
	const key = "organisation.accessRoles.assignments.status";
	return (
		mapRefusal(error, {
			alerts: {
				[`409 ${ASSIGNMENT_ERROR.roleInactive}`]: t(`${key}.roleInactive`),
				[`400 ${ASSIGNMENT_ERROR.invalid}`]: t(`${key}.notMember`),
			},
			forbidden: t(`${key}.forbidden`),
			failed: t(`${key}.failed`),
		}).message ?? t(`${key}.failed`)
	);
};
</file>

<file path="src/features/organisation/assignmentTargets.ts">
import type { TFunction } from "i18next";
import type { Branch, Department } from "@/features/organisation/api";

/** A place an access role can apply: the whole company, a Branch, or a Department. */
export type AssignmentTarget = {
	label: string;
	branchId?: string;
	departmentId?: string;
};

/** Identifies a place: its Department, else its Branch, else the whole company. */
export const placeKey = (place: {
	branchId?: string;
	departmentId?: string;
}): string => place.departmentId ?? place.branchId ?? "";

/** A place in words: the whole company, a Branch, or a Branch and its Department. */
export const placeOf = (
	place: { branchName?: string; departmentName?: string },
	t: TFunction
): string => {
	if (!place.branchName)
		return t("organisation.accessRoles.assignments.wholeCompany");
	if (!place.departmentName) return place.branchName;
	return t("organisation.accessRoles.assignments.department", {
		branch: place.branchName,
		department: place.departmentName,
	});
};

/** Every place a role can apply, widest first: the company, then each Branch followed by its Departments. */
export const assignmentTargets = (
	branches: ReadonlyArray<Branch>,
	departments: ReadonlyArray<Department>,
	t: TFunction
): Array<AssignmentTarget> => [
	{ label: placeOf({}, t) },
	...branches.flatMap((branch) => [
		{ label: branch.name, branchId: branch.branchId },
		...departments
			.filter((department) => department.branchId === branch.branchId)
			.map((department) => ({
				label: placeOf(
					{ branchName: branch.name, departmentName: department.name },
					t
				),
				branchId: branch.branchId,
				departmentId: department.departmentId,
			})),
	]),
];
</file>

