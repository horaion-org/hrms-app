it("handles revocation from a bearer retry after renewal", async () => {
	rememberCompany("a");
	stubApi({
		[REFRESH]: accessPassReply(),
		[ME]: [
			currentUserReply([membership("a")]),
			currentUserReply([membership("b")]),
