import { Field, Input, Label } from "@headlessui/react";
import { useId, type InputHTMLAttributes } from "react";
import { joinClassNames } from "@/common/joinClassNames";
import type { FunctionComponent } from "@/common/types";

type CheckboxProps = Omit<
	InputHTMLAttributes<HTMLInputElement>,
	"className" | "id" | "type"
> & {
	label: string;
	/** Keeps the label for assistive technology only, e.g. in a table cell. */
	hideLabel?: boolean;
	/** Shows the mixed state, e.g. for a select-all box over a partial selection. */
	indeterminate?: boolean;
	/** Classes for the wrapper holding the box and its label. */
	className?: string;
	/** Classes for the label's text, e.g. a heavier weight for a group's box. */
	labelClassName?: string;
};

export const Checkbox = ({
	label,
	hideLabel = false,
	indeterminate = false,
	className,
	labelClassName,
	...rest
}: CheckboxProps): FunctionComponent => {
	const id = useId();

	return (
		<Field className={joinClassNames("flex items-center gap-2", className)}>
			<Input
				// `indeterminate` exists only as a DOM property, never as an attribute.
				ref={(input: HTMLInputElement | null) => {
					if (input) input.indeterminate = indeterminate;
				}}
				className="size-4 shrink-0 accent-ink-blue-900 disabled:opacity-50"
				id={id}
				type="checkbox"
				{...rest}
			/>
			<Label
				htmlFor={id}
				className={joinClassNames(
					"text-base leading-6 text-slate-900",
					hideLabel && "sr-only",
					labelClassName
				)}
			>
				{label}
			</Label>
		</Field>
	);
};
</file>

<file path="src/features/organisation/CreateJobTitleDialog/CreateJobTitleDialog.tsx">
import { zodResolver } from "@hookform/resolvers/zod";
import { useQueryClient } from "@tanstack/react-query";
import { useEffect, useId, useMemo } from "react";
import { Controller, useForm, useWatch } from "react-hook-form";
import { useTranslation } from "react-i18next";
import type { FunctionComponent } from "@/common/types";
import { FormRow, formRowIds } from "@/components/forms/FormRow";
import { Select, type SelectOption } from "@/components/forms/Select";
import type { JobTitle } from "@/features/organisation/api";
import { placeOf } from "@/features/organisation/assignmentTargets";
import { CreateFormDialog } from "@/features/organisation/CreateFormDialog";
import { departmentChoices } from "@/features/organisation/departmentChoices";
import { refusalFor } from "@/features/organisation/CreateJobTitleDialog/refusalFor";
import {
	createJobTitleSchema,
	type CreateJobTitleValues,
} from "@/features/organisation/CreateJobTitleDialog/schema";
import { UnitNameField } from "@/features/organisation/UnitNameField";
import { useUpdateJobTitle } from "@/features/organisation/useChangeListRow";
import { useCreateFormSubmit } from "@/features/organisation/useCreateFormSubmit";
import { useCreateJobTitle } from "@/features/organisation/useCreateInOrganisation";
import {
	useBranches,
	useDepartments,
} from "@/features/organisation/useOrganisationList";
import { useCan } from "@/features/workspace/useCan";

export type CreateJobTitleDialogProps = {
	companyId: string;
	/** Set to rename an existing Job title; its Department is shown but can't change. */
	editing?: JobTitle;
	onClose: () => void;
};

const FIELDS = ["departmentId", "name"] as const;
const ACTIVE_BY_NAME = {
	sort: { field: "name", desc: false },
	status: "ACTIVE",
} as const;

/**
 * Creates a Job title in one Department, or renames one. Mount when opened
 * and unmount when closed so every attempt starts fresh.
 */
export const CreateJobTitleDialog = ({
	companyId,
	editing,
	onClose,
}: CreateJobTitleDialogProps): FunctionComponent => {
	const { t } = useTranslation();
	const can = useCan();
	const client = useQueryClient();
	const key = "organisation.jobTitles.createDialog";
	const formId = useId();
	const departmentId = `${formId}-department`;
	const departmentIds = formRowIds(departmentId);
	const schema = useMemo(() => createJobTitleSchema(t), [t]);
	const form = useForm<CreateJobTitleValues>({
		resolver: zodResolver(schema),
		defaultValues: {
			departmentId: editing?.departmentId ?? "",
			name: editing?.name ?? "",
		},
		mode: "onSubmit",
		reValidateMode: "onChange",
	});
	const {
		register,
		control,
		handleSubmit,
		getValues,
		setValue,
		formState: { errors, isSubmitting },
	} = form;
	const name = useWatch({ control, name: "name" });
	const branches = useBranches(companyId, ACTIVE_BY_NAME);
	const departments = useDepartments(companyId, ACTIVE_BY_NAME);
	const create = useCreateJobTitle(companyId);
	const update = useUpdateJobTitle(companyId);
	const submit = useCreateFormSubmit(form, FIELDS, onClose);
	// Only departments where the person may create job titles are offered; when editing, just the title's own.
	const departmentOptions: Array<SelectOption> = editing
		? [
				{
					value: editing.departmentId,
					label: placeOf(editing, t),
				},
			]
		: branches.status === "ready" && departments.status === "ready"
			? departmentChoices(
					branches.items,
					departments.items,
					(departmentId) => can("job_title:create", departmentId),
					t
				).map(({ department, label }) => ({
					value: department.departmentId,
					label,
				}))
			: [];
	const onlyDepartment =
		departmentOptions.length === 1 ? departmentOptions[0]?.value : undefined;
	useEffect(() => {
		// One department leaves nothing to choose.
		if (onlyDepartment && !getValues("departmentId"))
			setValue("departmentId", onlyDepartment);
	}, [onlyDepartment, getValues, setValue]);
	const loading =
		branches.status === "pending" || departments.status === "pending";
	const failed = branches.status === "error" || departments.status === "error";
	const departmentError = errors.departmentId?.message;
	return (
		<CreateFormDialog
			alertRef={submit.alertRef}
			cancelLabel={t(`${key}.cancel`)}
			formId={formId}
			message={submit.message}
			submitDisabled={!name.trim()}
			submitLabel={t(editing ? `${key}.editSubmit` : `${key}.submit`)}
			submitting={isSubmitting}
			title={t(editing ? `${key}.editTitle` : `${key}.title`)}
			description={
				editing
					? t(`${key}.editDescription`, { department: placeOf(editing, t) })
					: t(`${key}.description`)
			}
			onClose={submit.close}
			onSubmit={(event) =>
				handleSubmit(async (values) => {
					const refusal = await submit.run(
						() => {
							if (editing)
								return update.mutateAsync({ ...editing, name: values.name });
							const department =
								departments.status === "ready"
									? departments.items.find(
											(item) => item.departmentId === values.departmentId
										)
									: undefined;
							return create.mutateAsync({
								branchId: department?.branchId ?? "",
								departmentId: values.departmentId,
								body: { name: values.name },
							});
						},
						(error) => refusalFor(error, values.name, editing !== undefined, t)
					);
					if (refusal?.fields.departmentId)
						void client.invalidateQueries({
							queryKey: ["organisation", companyId, "departments"],
						});
				})(event)
			}
		>
			<FormRow
				required
				error={departmentError}
				htmlFor={departmentId}
				label={t(`${key}.department`)}
				layout="stacked"
				hint={
					editing
						? undefined
						: loading
							? t(`${key}.departmentsLoading`)
							: failed
								? t(`${key}.departmentsFailed`)
								: departmentOptions.length === 0
									? t(`${key}.departmentsEmpty`)
									: t(`${key}.departmentHint`)
				}
			>
				<Controller
					control={control}
					name="departmentId"
					render={({ field }) => (
						<Select
							ref={field.ref}
							aria-invalid={Boolean(departmentError)}
							aria-labelledby={departmentIds.labelId}
							className="w-full"
							name={field.name}
							options={departmentOptions}
							placeholder={t(`${key}.departmentPlaceholder`)}
							status={departmentError ? "error" : undefined}
							value={field.value}
							aria-describedby={
								departmentError ? departmentIds.errorId : departmentIds.hintId
							}
							disabled={
								isSubmitting ||
								editing !== undefined ||
								departmentOptions.length === 0
							}
							onChange={field.onChange}
						/>
					)}
				/>
			</FormRow>
			<UnitNameField
				autoFocus
				counter={t(`${key}.nameCounter`, { count: name.length })}
				disabled={isSubmitting}
				error={errors.name?.message}
				hint={t(`${key}.nameHint`)}
				id={`${formId}-name`}
				label={t(`${key}.name`)}
				placeholder={t(`${key}.namePlaceholder`)}
				registration={register("name")}
			/>
		</CreateFormDialog>
	);
};
</file>

<file path="src/features/organisation/listColumns.tsx">
import type { TFunction } from "i18next";
import type { ReactNode } from "react";
import type { SelectOption } from "@/components/forms/Select";
import { Badge } from "@/components/ui/Badge";
import { Button } from "@/components/ui/Button";
import type { DataTableColumn } from "@/components/ui/DataTable";
import { EditIcon } from "@/components/ui/Icon";
import { OverflowMenu } from "@/components/ui/OverflowMenu";
import type { UnitStatus } from "@/features/organisation/api";
import type { OrganisationList } from "@/features/organisation/useOrganisationList";

/** The "Showing:" filter's choice: every row, or one status. */
export type StatusFilter = "all" | UnitStatus;

export const statusFilterOptions = (
	t: TFunction,
	allLabel: string
): Array<SelectOption> => [
	{ value: "all", label: allLabel },
	{ value: "ACTIVE", label: t("organisation.status.ACTIVE") },
	{ value: "INACTIVE", label: t("organisation.status.INACTIVE") },
];

export const isStatusFilter = (value: string): value is StatusFilter =>
	value === "all" || value === "ACTIVE" || value === "INACTIVE";

/** The bold, sortable first column naming each row. */
export const nameColumn = <T extends { name: string }>(
	header: string
): DataTableColumn<T> => ({
	id: "name",
	header,
	cell: (row) => row.name,
	sortValue: (row) => row.name,
	cellClassName: "font-semibold",
});

export const statusColumn = <T extends { status: UnitStatus }>(
	t: TFunction
): DataTableColumn<T> => ({
	id: "status",
	header: t("organisation.list.status"),
	cell: (row) => (
		<Badge tone={row.status === "ACTIVE" ? "success" : "neutral"}>
			{t(`organisation.status.${row.status}`)}
		</Badge>
	),
	sortValue: (row) => row.status,
	headerClassName: "w-30",
});

/**
 * Each row's Edit button and "More actions" menu. `menu` decides which items
 * to offer. The button does nothing on a list whose editing is not built
 * yet, which is one that passes no `onEdit`.
 */
export const actionsColumn = <T extends { name: string }>(
	t: TFunction,
	menu: (row: T) => ReactNode,
	canEdit: (row: T) => boolean = (): boolean => true,
	onEdit?: (row: T) => void
): DataTableColumn<T> => ({
	id: "actions",
	header: t("organisation.list.actions"),
	cell: (row) => (
		<div className="flex items-center justify-center gap-2">
			<Button
				aria-label={t("organisation.list.edit", { name: row.name })}
				disabled={!canEdit(row)}
				variant="icon"
				onClick={
					onEdit &&
					((): void => {
						onEdit(row);
					})
				}
			>
				<EditIcon />
			</Button>
			<OverflowMenu
				label={t("organisation.list.moreActions", { name: row.name })}
				variant="icon"
			>
				{menu(row)}
			</OverflowMenu>
		</div>
	),
	headerClassName: "w-35",
	cellClassName: "px-0",
});

/** Whether a name contains the search, ignoring case and outer spaces. */
export const matchesSearch = (name: string, search: string): boolean =>
	name.toLocaleLowerCase().includes(search.trim().toLocaleLowerCase());

/** What a list page shows for a list's state. */
export type ListView<T> = {
	rows: Array<T>;
	/** Shown in the table body when `rows` is empty. */
	empty: string;
	/** Replaces the table when the list can't be shown. */
	problem?: { message: string; alert: boolean };
	/** Set when the API holds more rows than one page returns. */
	truncated?: string;
};

const NO_ROWS: Array<never> = [];

/**
 * Turns a fetched list into rows filtered by the search, with the copy for
 * every state. `emptyText` is the list's own "No … yet." line.
 */
export const describeList = <T extends { name: string }>(
	list: OrganisationList<T>,
	search: string,
	filtered: boolean,
	emptyText: string,
	t: TFunction,
	matches: (row: T, search: string) => boolean = (row, query) =>
		matchesSearch(row.name, query)
): ListView<T> => {
	switch (list.status) {
		case "pending":
			return { rows: NO_ROWS, empty: t("organisation.list.loading") };
		case "hidden":
			return {
				rows: NO_ROWS,
				empty: emptyText,
				problem: { message: t("organisation.list.forbidden"), alert: false },
			};
		case "error":
			return {
				rows: NO_ROWS,
				empty: emptyText,
				problem: { message: t("organisation.list.failed"), alert: true },
			};
		case "ready": {
			// Unfiltered rows keep their identity, so the table keeps its models.
			const rows = search.trim()
				? list.items.filter((row) => matches(row, search))
				: list.items;
			return {
				rows,
				empty:
					search.trim() || filtered
						? t("organisation.list.noMatches")
						: emptyText,
				truncated:
					list.total > list.items.length
						? t("organisation.list.truncated", {
								shown: list.items.length,
								total: list.total,
							})
						: undefined,
			};
		}
		default: {
			const exhaustive: never = list;
			return exhaustive;
		}
	}
};
