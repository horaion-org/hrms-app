<file path="src/features/organisation/useAccessRoleHolders.ts">
import {
	useMutation,
	useQuery,
	useQueryClient,
	type UseMutationResult,
	type UseQueryResult,
} from "@tanstack/react-query";
import {
	fetchAccessRoleHolders,
	grantAccessRole,
	revokeAccessRole,
	setAccessRoleAssignmentStatus,
	type AccessRoleGrant,
	type UnitStatus,
} from "@/features/organisation/api";
import type { AccessRoleAssignmentRow } from "@/features/organisation/AccessRoleAssignments";
import { workspaceQuery } from "@/features/workspace/api";
import { retry } from "@/features/workspace/retry";

/** Who holds an access role and where, as the rows the people table shows. */
export const useAccessRoleHolders = (
	companyId: string,
	accessRoleId: string
): UseQueryResult<Array<AccessRoleAssignmentRow>> =>
	useQuery({
		queryKey: ["organisation", companyId, "access-role-holders", accessRoleId],
		queryFn: () => fetchAccessRoleHolders(companyId, accessRoleId),
		retry,
		select: (holders) =>
			holders.map((holder) => ({
				assignmentId: holder.accessRoleAssignmentId,
				membershipId: holder.companyMembershipId,
				name: holder.displayName,
				status: holder.status,
				branchId: holder.branchId ?? undefined,
				branchName: holder.branchName ?? undefined,
				departmentId: holder.departmentId ?? undefined,
				departmentName: holder.departmentName ?? undefined,
			})),
	});

/**
 * Changes to who holds a role, made together: places to add it at,
 * assignments to remove, and assignments to switch on or off.
 */
export type AccessRoleHoldersChange = {
	grants?: Array<AccessRoleGrant>;
	revokes?: Array<string>;
	statuses?: { assignmentIds: Array<string>; status: UnitStatus };
};

/**
 * Assigning an access role, and removing or switching assignments of it. One request is
 * sent per place, so whatever succeeded before a refusal stays as it is.
 * Either may change what the person themselves can do, so the workspace is
 * refreshed along with the lists.
 */
export const useChangeAccessRoleHolders = (
	companyId: string
): UseMutationResult<void, Error, AccessRoleHoldersChange> => {
	const client = useQueryClient();
	return useMutation({
		mutationFn: async ({
			grants = [],
			revokes = [],
			statuses = { assignmentIds: [], status: "ACTIVE" },
		}: AccessRoleHoldersChange) => {
			await Promise.all([
				...grants.map((grant) => grantAccessRole(companyId, grant)),
				...revokes.map((id) => revokeAccessRole(companyId, id)),
				...statuses.assignmentIds.map((id) =>
					setAccessRoleAssignmentStatus(companyId, id, statuses.status)
				),
			]);
		},
		onSettled: () =>
			Promise.all([
				client.invalidateQueries({ queryKey: ["organisation", companyId] }),
				client.invalidateQueries({ queryKey: workspaceQuery.queryKey }),
			]),
	});
};
</file>

<file path="src/features/organisation/useChangeListRow.ts">
import {
	useMutation,
	useQueryClient,
	type UseMutationResult,
} from "@tanstack/react-query";
import {
	deleteAccessRole,
	updateAccessRole,
	updateBranch,
	updateDepartment,
	updateJobTitle,
	type AccessRole,
	type Branch,
	type Department,
	type JobTitle,
	type UnitStatus,
} from "@/features/organisation/api";
import { workspaceQuery } from "@/features/workspace/api";

/**
 * A change made from a list row. It refreshes the company's lists and
 * activity, and the workspace too, because activating, deactivating or
 * deleting something can change what the person themselves may do.
 */
const useRowChange = <TVariables, TResult>(
	companyId: string,
	change: (variables: TVariables) => Promise<TResult>
): UseMutationResult<TResult, Error, TVariables> => {
	const client = useQueryClient();
	return useMutation({
		mutationFn: change,
		onSuccess: () =>
			Promise.all([
				client.invalidateQueries({ queryKey: ["organisation", companyId] }),
				client.invalidateQueries({ queryKey: workspaceQuery.queryKey }),
			]),
	});
};

export type StatusChange<T> = { row: T; status: UnitStatus };

/** Activates or deactivates a Branch, leaving its other details as they are. */
export const useSetBranchStatus = (
	companyId: string
): UseMutationResult<Branch, Error, StatusChange<Branch>> =>
	useRowChange(companyId, ({ row, status }: StatusChange<Branch>) =>
		updateBranch(companyId, { ...row, status })
	);

/** Activates or deactivates a Department, leaving its name as it is. */
export const useSetDepartmentStatus = (
	companyId: string
): UseMutationResult<Department, Error, StatusChange<Department>> =>
	useRowChange(companyId, ({ row, status }: StatusChange<Department>) =>
		updateDepartment(companyId, { ...row, status })
	);

/** Renames a Job title; its status and Department stay as they are. */
export const useUpdateJobTitle = (
	companyId: string
): UseMutationResult<JobTitle, Error, JobTitle> =>
	useRowChange(companyId, (jobTitle: JobTitle) =>
		updateJobTitle(companyId, jobTitle)
	);

/** Activates or deactivates a Job title, leaving its name as it is. */
export const useSetJobTitleStatus = (
	companyId: string
): UseMutationResult<JobTitle, Error, StatusChange<JobTitle>> =>
	useRowChange(companyId, ({ row, status }: StatusChange<JobTitle>) =>
		updateJobTitle(companyId, { ...row, status })
	);

/** Activates or deactivates an access role, leaving its name and permissions as they are. */
export const useSetAccessRoleStatus = (
	companyId: string
): UseMutationResult<AccessRole, Error, StatusChange<AccessRole>> =>
	useRowChange(companyId, ({ row, status }: StatusChange<AccessRole>) =>
		updateAccessRole(companyId, row.accessRoleId, {
			name: row.name,
			permissions: row.permissions,
			status,
		})
	);

/** Deletes an access role nobody holds. */
export const useDeleteAccessRole = (
	companyId: string
): UseMutationResult<void, Error, AccessRole> =>
	useRowChange(companyId, (role: AccessRole) =>
		deleteAccessRole(companyId, role.accessRoleId)
	);
