import { endSession } from "@/features/auth/session";
import { renderAuthApp } from "@/features/auth/testing";

const DEPARTMENTS = "GET /api/v1/companies/c-1/departments";
const BRANCHES = "GET /api/v1/companies/c-1/branches";
const MEMBERS = "GET /api/v1/companies/c-1/members";
const CREATE_IN = (branchId: string): string =>
	`POST /api/v1/companies/c-1/branches/${branchId}/departments`;
const permissions = [
	"department:read",
	"department:create",
	"company_member:read",
	"branch:read",
];
const member = {
	membershipId: "m-1",
	displayName: "Marcus Lim",
	status: "ACTIVE",
};
const orchard = {
	branchId: "b-1",
	name: "Orchard Road",
	status: "ACTIVE",
	code: "ORC",
	city: "Singapore",
	country: "SG",
};
const tampines = {
	branchId: "b-2",
	name: "Tampines",
	status: "ACTIVE",
	code: "TAM",
	city: "Singapore",
	country: "SG",
};
const department = {
	departmentId: "d-1",
	branchId: "b-1",
	companyId: "c-1",
	name: "Front of house",
	status: "ACTIVE",
	headMembershipIds: ["m-1"],
};
const page = (
	content: Array<unknown>,
	totalElements = content.length
): StubReply => ({
	status: 200,
	body: envelope({ content, page: { totalElements } }),
});
const routes = (
	grants = permissions,
	branches: Array<unknown> = [orchard, tampines]
): Record<string, StubReply> => ({
	"POST /api/v1/public/sessions/refreshes": accessPassReply(),
	"GET /api/v1/me": currentUserReply(),
	"GET /api/v1/me/workspace": {
		status: 200,
		body: envelope({
			companies: [
				{ uuid: "c-1", name: "Company c-1", permissions: grants, branches: [] },
