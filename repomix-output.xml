describe("Calendar stories", () => {
	const {
		Days,
		NoValue,
		Spanish,
		Months,
		Years,
		Range,
		RangeAcrossMonths,
		DraftRange,
		MinMax,
		DisabledDates,
		RangeAcrossDisabledDay,
	} = composeStories(stories);
	it.each([
		{ Story: MinMax, disabled: "Tuesday, 9 June 2026", selected: false },
		{
			Story: DisabledDates,
			disabled: "Saturday, 13 June 2026",
			selected: false,
		},
