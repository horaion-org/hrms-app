<file path="src/features/workspace/api.ts">
import { queryOptions } from "@tanstack/react-query";
import { z } from "zod";
import { apiRequest } from "@/common/api-client";

const permissionsSchema = z.array(z.string());

const workspaceSchema = z.object({
	companies: z.array(
		z.object({
			uuid: z.string(),
			name: z.string(),
			permissions: permissionsSchema,
			branches: z.array(
				z.object({
					uuid: z.string(),
					name: z.string(),
					permissions: permissionsSchema,
					departments: z.array(
						z.object({
							uuid: z.string(),
							name: z.string(),
							permissions: permissionsSchema,
						})
					),
				})
			),
		})
	),
});

export type Workspace = z.infer<typeof workspaceSchema>;

/**
 * The caller's visible unit tree with the permissions held at each node
 * (`GET /api/v1/me/workspace`). It decides what to show, never what is
 * allowed: the API still checks every request.
 */
export const workspaceQuery = queryOptions({
	queryKey: ["workspace"],
	queryFn: () => apiRequest("/api/v1/me/workspace", workspaceSchema),
	staleTime: Infinity,
});

/** Permissions held at the company itself; empty for a company not in the workspace. */
export const companyPermissions = (
	workspace: Workspace,
	companyId: string
): ReadonlySet<string> =>
	new Set(
		workspace.companies.find((company) => company.uuid === companyId)
			?.permissions ?? []
	);
</file>

<file path="src/features/workspace/refreshWorkspaceOnRefusal.test.ts">
import { QueryClient } from "@tanstack/react-query";
import { afterEach, describe, expect, it, vi } from "vitest";
import { ApiProblemError } from "@/common/problem";
import { workspaceQuery } from "@/features/workspace/api";
import { refreshWorkspaceOnRefusal } from "@/features/workspace/refreshWorkspaceOnRefusal";

const refusal = (status: number, errorCode: string): ApiProblemError =>
	new ApiProblemError({
		message: "Refused",
		status,
		errorCode,
		fieldErrors: [],
		reason: "http",
	});

let stop: (() => void) | undefined;
afterEach(() => {
	stop?.();
	stop = undefined;
});

const listen = (): QueryClient => {
	const queryClient = new QueryClient({
		defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
	});
	stop = refreshWorkspaceOnRefusal(queryClient);
	return queryClient;
};

const failQuery = async (
	queryClient: QueryClient,
	queryKey: ReadonlyArray<string>,
	error: Error
): Promise<void> => {
	await queryClient
		.fetchQuery({ queryKey, queryFn: () => Promise.reject(error) })
		.catch(() => undefined);
};

describe("refreshWorkspaceOnRefusal", () => {
	it("reloads the workspace when a query is refused with a 403", async () => {
		const queryClient = listen();
		const invalidate = vi.spyOn(queryClient, "invalidateQueries");
		await failQuery(queryClient, ["branches"], refusal(403, "ACCESS_DENIED"));
		expect(invalidate).toHaveBeenCalledWith({
			queryKey: workspaceQuery.queryKey,
		});
	});

	it("reloads the workspace when a mutation is refused with a 403", async () => {
		const queryClient = listen();
		const invalidate = vi.spyOn(queryClient, "invalidateQueries");
		await queryClient
			.getMutationCache()
			.build(queryClient, {
				mutationFn: () => Promise.reject(refusal(403, "ACCESS_DENIED")),
			})
			.execute(undefined)
			.catch(() => undefined);
		expect(invalidate).toHaveBeenCalledTimes(1);
	});

	it("leaves other failures, revoked memberships and the workspace's own refusal alone", async () => {
		const queryClient = listen();
		const invalidate = vi.spyOn(queryClient, "invalidateQueries");
		await failQuery(queryClient, ["branches"], refusal(404, "NOT_FOUND"));
		await failQuery(queryClient, ["branches"], new Error("offline"));
		await failQuery(
			queryClient,
			["branches"],
			refusal(403, "MEMBERSHIP_REVOKED")
		);
		await failQuery(
			queryClient,
			[...workspaceQuery.queryKey],
			refusal(403, "ACCESS_DENIED")
		);
		expect(invalidate).not.toHaveBeenCalled();
	});

	it("stops listening once stopped", async () => {
		const queryClient = listen();
		const invalidate = vi.spyOn(queryClient, "invalidateQueries");
		stop?.();
		await failQuery(queryClient, ["branches"], refusal(403, "ACCESS_DENIED"));
		expect(invalidate).not.toHaveBeenCalled();
	});
});
</file>

<file path="src/features/workspace/refreshWorkspaceOnRefusal.ts">
import type { QueryClient, QueryKey } from "@tanstack/react-query";
import { ApiProblemError } from "@/common/problem";
import { workspaceQuery } from "@/features/workspace/api";

const FORBIDDEN = 403;
/** Handled by the Session wiring, which re-settles the current company. */
const MEMBERSHIP_REVOKED = "MEMBERSHIP_REVOKED";

/**
 * Reloads the workspace whenever the API refuses a request with a 403. The
 * workspace decides which controls are shown, so a refusal on something the
 * person was shown means their grants changed after it was loaded. Reloading
 * it makes the control they should no longer see disappear.
 *
 * A refusal of the workspace request itself is ignored, or it would ask for
 * itself in a loop. Returns a function that stops listening.
 */
export const refreshWorkspaceOnRefusal = (
	queryClient: QueryClient
): (() => void) => {
	const refresh = (error: unknown, refusedKey?: QueryKey): void => {
		if (!(error instanceof ApiProblemError) || error.status !== FORBIDDEN)
			return;
		if (error.errorCode === MEMBERSHIP_REVOKED) return;
		if (refusedKey?.[0] === workspaceQuery.queryKey[0]) return;
		void queryClient.invalidateQueries({ queryKey: workspaceQuery.queryKey });
	};
	const stopQueries = queryClient.getQueryCache().subscribe((event) => {
		if (event.type === "updated" && event.action.type === "error")
			refresh(event.action.error, event.query.queryKey as QueryKey);
	});
	const stopMutations = queryClient.getMutationCache().subscribe((event) => {
		if (event.type === "updated" && event.action.type === "error")
			refresh(event.action.error);
	});
	return (): void => {
		stopQueries();
		stopMutations();
	};
};
</file>

