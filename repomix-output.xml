	},
	[DEPARTMENTS]: page([]),
	[BRANCHES]: page(branches),
	[MEMBERS]: page([member]),
	[CREATE_IN("b-1")]: { status: 201, body: envelope(department) },
	[CREATE_IN("b-2")]: { status: 201, body: envelope(department) },
});
let app: OpenedApp | undefined;
beforeEach(() => {
