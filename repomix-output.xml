import { useId } from "react";
import type { FunctionComponent } from "@/common/types";
import { Input } from "@/components/forms/Input";
import { Select, type SelectOption } from "@/components/forms/Select";
import { Button } from "@/components/ui/Button";
import { PlusIcon, SearchIcon } from "@/components/ui/Icon";

export type ListToolbarProps = {
	/** Names the search box and shows as its placeholder, e.g. "Search Branch". */
	searchLabel: string;
	search: string;
	onSearchChange: (search: string) => void;
	/** The primary action's label, e.g. "Create Branch"; needed only with `onCreate`. */
	createLabel?: string;
	onCreate?: () => void;
	/** A second action beside the primary one, e.g. "Assign role"; left out when there is none. */
	secondaryAction?: { label: string; onClick: () => void };
	/** The "Showing:" filter under the toolbar; left out when the list has none. */
	filter?: {
		label: string;
		value: string;
		options: Array<SelectOption>;
		onChange: (value: string) => void;
	};
	/**
	 * The "Showing:" filter with each option ticked on its own, in place of
	 * `filter`. `placeholder` and `formatSummary` name the choice when none or
	 * several are ticked.
	 */
	multipleFilter?: {
		label: string;
		value: Array<string>;
		options: Array<SelectOption>;
		onChange: (value: Array<string>) => void;
		placeholder?: string;
		formatSummary?: (selected: Array<SelectOption>) => string;
	};
	className?: string;
};

/** A list's search, create action, and status filter; People uses it too. */
export const ListToolbar = ({
	searchLabel,
	search,
	onSearchChange,
	createLabel,
	onCreate,
	secondaryAction,
	filter,
	multipleFilter,
	className,
}: ListToolbarProps): FunctionComponent => {
	const filterLabelId = useId();
	const filterLabel = (filter ?? multipleFilter)?.label;
	return (
		<div className={className}>
			<div className="flex flex-wrap items-center justify-between gap-4">
				<Input
					aria-label={searchLabel}
					className="w-full sm:w-97.5"
					leadingIcon={<SearchIcon />}
					placeholder={searchLabel}
					type="search"
					value={search}
					onChange={(event) => {
						onSearchChange(event.target.value);
					}}
				/>
				<div className="flex flex-wrap items-center gap-3">
					{secondaryAction && (
						<Button variant="secondary" onClick={secondaryAction.onClick}>
							{secondaryAction.label}
						</Button>
					)}
					{onCreate && (
						<Button leadingIcon={<PlusIcon />} onClick={onCreate}>
							{createLabel}
						</Button>
					)}
				</div>
			</div>
			{filterLabel !== undefined && (
				<div className="mt-10 flex items-center gap-3">
					<span
						className="min-w-15.5 text-sm font-medium text-neutral-800"
						id={filterLabelId}
					>
						{filterLabel}
					</span>
					{filter && (
						<Select
							aria-labelledby={filterLabelId}
							className="w-40 font-semibold"
							options={filter.options}
							value={filter.value}
							onChange={filter.onChange}
						/>
					)}
					{!filter && multipleFilter && (
						<Select
							multiple
							aria-labelledby={filterLabelId}
							className="w-40 font-semibold"
							formatSummary={multipleFilter.formatSummary}
							options={multipleFilter.options}
							placeholder={multipleFilter.placeholder}
							value={multipleFilter.value}
							onChange={multipleFilter.onChange}
						/>
					)}
				</div>
			)}
		</div>
	);
};
</file>

<file path="src/features/organisation/PermissionChecklist/PermissionChecklist.test.tsx">
import { render, screen, within } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { useState, type ReactElement } from "react";
import { I18nextProvider } from "react-i18next";
import { describe, expect, it } from "vitest";
import { authTestI18n } from "@/features/auth/testingI18n";
import { PermissionChecklist } from "@/features/organisation/PermissionChecklist";
import {
	PERMISSION_KEYS,
	type PermissionKey,
} from "@/features/workspace/permissionKeys";

let latest: Array<PermissionKey> = [];

const Harness = ({
	initial,
	disabled,
	unavailable,
}: {
	initial: Array<PermissionKey>;
	disabled?: boolean;
	unavailable?: Array<PermissionKey>;
}): ReactElement => {
	const [value, setValue] = useState(initial);
	return (
		<I18nextProvider i18n={authTestI18n}>
			<PermissionChecklist
				disabled={disabled}
				label="Permissions"
				unavailable={unavailable}
				value={value}
				onChange={(next) => {
					latest = next;
					setValue(next);
				}}
			/>
		</I18nextProvider>
	);
};

const row = (name: string): HTMLElement => screen.getByRole("group", { name });
const box = (group: string, name: string): HTMLElement =>
	within(row(group)).getByRole("checkbox", { name });

describe("PermissionChecklist", () => {
	it("shows one row per resource with a box for every permission in the catalog", () => {
		render(<Harness initial={[]} />);

		expect(
			within(screen.getByRole("group", { name: "Permissions" }))
				.getAllByRole("group")
				.map((group) => group.getAttribute("aria-label"))
		).toEqual([
			"Company",
			"Company members",
			"Branches",
			"Branch members",
			"Departments",
			"Department members",
			"Job titles",
			"People",
			"Notes",
			"System roles",
			"Activity",
		]);
		// One box per key, plus each row's own.
		expect(screen.getAllByRole("checkbox")).toHaveLength(
			PERMISSION_KEYS.length + 11
		);
		expect(within(row("System roles")).getAllByRole("checkbox")).toHaveLength(
			6
		);
		expect(within(row("People")).getAllByRole("checkbox")).toHaveLength(4);
		expect(box("People", "Create")).not.toBeChecked();
		expect(box("People", "Edit")).not.toBeChecked();
		expect(within(row("Notes")).getAllByRole("checkbox")).toHaveLength(5);
		for (const action of ["View", "Add", "Edit", "Delete"])
			expect(box("Notes", action)).not.toBeChecked();
	});

	it("ticks what the role holds and counts it per row", () => {
		render(<Harness initial={["branch:read", "branch:create"]} />);

		expect(box("Branches", "View")).toBeChecked();
		expect(box("Branches", "Create")).toBeChecked();
		expect(box("Branches", "Edit")).not.toBeChecked();
		expect(box("Branches", "Branches")).toBePartiallyChecked();
		expect(within(row("Branches")).getByText("2 of 3")).toBeVisible();
		expect(within(row("Departments")).getByText("0 of 3")).toBeVisible();
	});

	it("ticks view along with any other permission of the resource", async () => {
		const user = userEvent.setup();
		render(<Harness initial={[]} />);

		await user.click(box("Branches", "Edit"));

		expect(latest).toEqual(["branch:read", "branch:update"]);
		expect(box("Branches", "View")).toBeChecked();
	});

	it("clears the whole resource when view is cleared", async () => {
		const user = userEvent.setup();
		render(
			<Harness initial={["branch:read", "branch:update", "department:read"]} />
		);

		await user.click(box("Branches", "View"));

		expect(latest).toEqual(["department:read"]);
	});

	it("clears one permission without touching the rest", async () => {
		const user = userEvent.setup();
		render(<Harness initial={["branch:read", "branch:update"]} />);

		await user.click(box("Branches", "Edit"));

		expect(latest).toEqual(["branch:read"]);
	});

	it("ticks and clears a whole resource from the row's own box, in catalog order", async () => {
		const user = userEvent.setup();
		render(<Harness initial={["audit_event:read", "branch:read"]} />);

		await user.click(box("Branches", "Branches"));

		expect(latest).toEqual([
			"branch:read",
			"branch:create",
			"branch:update",
			"audit_event:read",
		]);
		expect(box("Branches", "Branches")).toBeChecked();

		await user.click(box("Branches", "Branches"));

		expect(latest).toEqual(["audit_event:read"]);
	});

	it("never ticks an unavailable permission, by its box, its row or what a tick implies", async () => {
		const user = userEvent.setup();
		render(
			<Harness
				initial={[]}
				unavailable={["branch:update", "department:read", "audit_event:read"]}
			/>
		);

		expect(box("Branches", "Edit")).toBeDisabled();
		expect(box("Activity", "Activity")).toBeDisabled();

		await user.click(box("Branches", "Branches"));
		expect(latest).toEqual(["branch:read", "branch:create"]);
		expect(box("Branches", "Branches")).toBeChecked();

		await user.click(box("Branches", "Branches"));
		expect(latest).toEqual([]);

		await user.click(box("Departments", "Edit"));
		expect(latest).toEqual(["department:update"]);
	});

	it("lets nothing be changed when disabled", () => {
		render(<Harness disabled initial={["branch:read"]} />);

		for (const item of screen.getAllByRole("checkbox"))
			expect(item).toBeDisabled();
		expect(box("Branches", "View")).toBeChecked();
	});
});
</file>

<file path="src/features/organisation/SystemRoleCreate.test.tsx">
import { screen, within } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import { resetApiClient } from "@/common/api-client";
import {
	currentUserReply,
	openApp,
	type OpenedApp,
} from "@/common/testing/openApp";
import {
	accessPassReply,
	envelope,
	problemReply,
	stubApi,
	type StubReply,
} from "@/common/testing/stubApi";
import { endSession } from "@/features/auth/session";
import { renderAuthApp } from "@/features/auth/testing";
import { PERMISSION_KEYS } from "@/features/workspace/permissionKeys";

const ROLES = "GET /api/v1/companies/c-1/access-roles";
const CREATE = "POST /api/v1/companies/c-1/access-roles";
const LIST = "/organisation/system-roles";
const CREATOR = "/organisation/system-roles/new";

const role = (
	overrides: Record<string, unknown> = {}
): Record<string, unknown> => ({
	accessRoleId: "r-2",
	companyId: "c-1",
	name: "Manager",
	protectedRole: false,
	status: "ACTIVE",
	holderCount: 0,
	permissions: ["branch:read"],
	...overrides,
});

const rolesReply = (
	roles: Array<Record<string, unknown>> = [role()]
): StubReply => ({
	status: 200,
	body: envelope({ content: roles, page: { totalElements: roles.length } }),
});

const routes = (
	held: ReadonlyArray<string> = PERMISSION_KEYS
): Record<string, StubReply> => ({
	"POST /api/v1/public/sessions/refreshes": accessPassReply(),
	"GET /api/v1/me": currentUserReply(),
	"GET /api/v1/me/workspace": {
		status: 200,
		body: envelope({
			companies: [
				{ uuid: "c-1", name: "Company c-1", permissions: held, branches: [] },
			],
		}),
	},
	[ROLES]: rolesReply(),
	[CREATE]: {
		status: 201,
		body: envelope(role({ accessRoleId: "r-3", name: "Supervisor" })),
	},
});

let app: OpenedApp | undefined;
beforeEach(() => {
	vi.spyOn(window, "scrollTo").mockImplementation(() => {});
});
afterEach(() => {
	app?.disconnect();
	app?.queryClient.clear();
	app = undefined;
	endSession("expired");
	resetApiClient();
	vi.unstubAllGlobals();
	vi.restoreAllMocks();
	localStorage.clear();
});

const open = async (entry: string): Promise<OpenedApp> => {
	app = await openApp(entry);
	renderAuthApp(app);
	return app;
};

const box = (group: string, name: string): HTMLElement =>
	within(screen.getByRole("group", { name: group })).getByRole("checkbox", {
		name,
	});
const create = (): HTMLElement =>
	screen.getByRole("button", { name: "Create role" });

/** Names the role, gives it Branches > Edit and submits it. */
const fillIn = async (name: string): Promise<void> => {
	const user = userEvent.setup();
	await user.type(
		await screen.findByRole("textbox", { name: /Role name/ }),
		name
	);
	await user.click(box("Branches", "Edit"));
	await user.click(create());
};

describe("Create system role", () => {
	it("opens an empty creation dialog from the list", async () => {
		const user = userEvent.setup();
		stubApi(routes());
		const opened = await open(LIST);

		await user.click(
			await screen.findByRole("button", { name: "Create system role" })
		);

		const dialog = await screen.findByRole("dialog", {
			name: "Create system role",
		});
		expect(dialog).toBeVisible();
		expect(opened.router.state.location.pathname).toBe(LIST);
		expect(
			within(dialog).getByRole("textbox", { name: /Role name/ })
		).toHaveValue("");
		for (const item of within(dialog).getAllByRole("checkbox"))
			expect(item).not.toBeChecked();
		expect(
			within(dialog).getByText("Choose at least 1 permission.")
		).toBeVisible();
		expect(screen.queryByText(/unavailable/)).not.toBeInTheDocument();
	});

	it("offers no Create Role button without permission to create roles", async () => {
		stubApi(routes(["access_role:read", "access_role:update"]));
		await open(LIST);

		await screen.findByRole("button", { name: "Edit Manager" });
		expect(
			screen.queryByRole("button", { name: "Create system role" })
		).not.toBeInTheDocument();
	});

	it("creates the role with the trimmed name and ticked permissions, then lists it", async () => {
		const calls = stubApi({
			...routes(),
			[ROLES]: [
				rolesReply(),
				rolesReply([role(), role({ accessRoleId: "r-3", name: "Supervisor" })]),
			],
		});

		await open(LIST);
		await screen.findByText("Manager");
		await app?.router.navigate({ to: CREATOR });
		await fillIn("  Supervisor ");

		expect(
			await screen.findByRole("heading", { level: 1, name: "System roles" })
		).toBeVisible();
		expect(app?.router.state.location.pathname).toBe(LIST);
		expect(
			calls
				.filter((call) => `${call.method} ${call.path}` === CREATE)
				.map((call) => call.body)
		).toEqual([
			{ name: "Supervisor", permissions: ["branch:read", "branch:update"] },
		]);
		expect(await screen.findByText("Supervisor")).toBeVisible();
	});

	it("shows a taken name on the name field and stays on the page", async () => {
		stubApi({
			...routes(),
			[CREATE]: problemReply(409, "ACCESS_ROLE_NAME_CONFLICT"),
		});

		await open(CREATOR);
		await fillIn("Manager");

		expect(
			await screen.findByText(
				'A role named "Manager" already exists. Choose a different name.'
			)
		).toBeVisible();
		const name = screen.getByRole("textbox", { name: /Role name/ });
		expect(name).toHaveFocus();
		expect(name).toHaveValue("Manager");
		expect(app?.router.state.location.pathname).toBe(CREATOR);
		expect(screen.queryByText(/API says/)).not.toBeInTheDocument();
	});

	it("explains a create the API refuses for permissions the person doesn't hold", async () => {
		stubApi({
			...routes(),
			[CREATE]: problemReply(403, "AUTHORIZATION_DENIED"),
		});

		await open(CREATOR);
		await fillIn("Supervisor");

		expect(await screen.findByRole("alert")).toHaveTextContent(
			"This role includes permissions you don’t hold, or you can no longer change system roles."
		);
		expect(screen.queryByText(/API says/)).not.toBeInTheDocument();
		expect(box("Branches", "Edit")).toBeChecked();
		expect(app?.router.state.location.pathname).toBe(CREATOR);
	});

	it("offers only the permissions the person holds at the company", async () => {
		const user = userEvent.setup();
		stubApi(
			routes(["access_role:read", "access_role:create", "branch:update"])
		);
		await open(CREATOR);
		await screen.findByRole("textbox", { name: /Role name/ });

		expect(
			screen.getByText(
				"You can only give a role permissions you hold yourself, so the others are unavailable."
			)
		).toBeVisible();
		expect(box("Branches", "View")).toBeDisabled();
		expect(box("Branches", "Create")).toBeDisabled();
		expect(box("Branches", "Edit")).toBeEnabled();
		expect(box("Departments", "Departments")).toBeDisabled();

		// Neither the row's select-all nor the automatic View adds what isn't held.
		await user.click(box("Branches", "Branches"));
		expect(box("Branches", "Edit")).toBeChecked();
		expect(box("Branches", "View")).not.toBeChecked();
		expect(box("Branches", "Create")).not.toBeChecked();
		await user.click(box("Branches", "Branches"));
		await user.click(box("Branches", "Edit"));
		expect(box("Branches", "View")).not.toBeChecked();
	});

	it("says so instead of showing the form without permission to create roles", async () => {
		stubApi(routes(["access_role:read"]));
		await open(CREATOR);

		expect(
			await screen.findByText(
				"You don’t have permission to create system roles."
			)
		).toBeVisible();
		expect(
			screen.queryByRole("textbox", { name: /Role name/ })
		).not.toBeInTheDocument();
		expect(screen.queryAllByRole("checkbox")).toHaveLength(0);
	});
});
</file>

<file path="src/features/organisation/SystemRoleEditor.test.tsx">
import { screen, waitFor, within } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import { resetApiClient } from "@/common/api-client";
import {
	currentUserReply,
	openApp,
	type OpenedApp,
} from "@/common/testing/openApp";
import {
	accessPassReply,
	envelope,
	problemReply,
	stubApi,
	type StubReply,
} from "@/common/testing/stubApi";
import { endSession } from "@/features/auth/session";
import { renderAuthApp } from "@/features/auth/testing";
import { PERMISSION_KEYS } from "@/features/workspace/permissionKeys";

const WORKSPACE = "GET /api/v1/me/workspace";
const ROLES = "GET /api/v1/companies/c-1/access-roles";
const ROLE = "GET /api/v1/companies/c-1/access-roles/r-2";
const HOLDERS =
	"GET /api/v1/companies/c-1/access-roles/r-2/access-role-assignments";
const SAVE = "PUT /api/v1/companies/c-1/access-roles/r-2";
const ROLE_PAGE = "/organisation/system-roles/r-2";
const EDITOR = `${ROLE_PAGE}?tab=permissions`;

const role = (
	overrides: Record<string, unknown> = {}
): Record<string, unknown> => ({
	accessRoleId: "r-2",
	companyId: "c-1",
	name: "Manager",
	protectedRole: false,
	status: "ACTIVE",
	permissions: ["branch:read", "branch:create", "department:read"],
	holderCount: 0,
	...overrides,
});

const roleReply = (overrides: Record<string, unknown> = {}): StubReply => ({
	status: 200,
	body: envelope(role(overrides)),
});

const routes = (
	held: ReadonlyArray<string> = PERMISSION_KEYS
): Record<string, StubReply> => ({
	"POST /api/v1/public/sessions/refreshes": accessPassReply(),
	"GET /api/v1/me": currentUserReply(),
	[WORKSPACE]: {
		status: 200,
		body: envelope({
			companies: [
				{ uuid: "c-1", name: "Company c-1", permissions: held, branches: [] },
			],
		}),
	},
	[ROLES]: {
		status: 200,
		body: envelope({ content: [role()], page: { totalElements: 1 } }),
	},
	[ROLE]: roleReply(),
	[HOLDERS]: { status: 200, body: envelope([]) },
	[SAVE]: roleReply(),
});

let app: OpenedApp | undefined;
beforeEach(() => {
	vi.spyOn(window, "scrollTo").mockImplementation(() => {});
});
afterEach(() => {
	app?.disconnect();
	app?.queryClient.clear();
	app = undefined;
	endSession("expired");
	resetApiClient();
	vi.unstubAllGlobals();
	vi.restoreAllMocks();
	localStorage.clear();
});

const open = async (entry: string): Promise<OpenedApp> => {
	app = await openApp(entry);
	renderAuthApp(app);
	return app;
};

const box = (group: string, name: string): HTMLElement =>
	within(screen.getByRole("group", { name: group })).getByRole("checkbox", {
		name,
	});
const save = (): HTMLElement =>
	screen.getByRole("button", { name: "Save changes" });

describe("System role editor", () => {
	it("opens on the role's permissions from the list's Edit button", async () => {
		const user = userEvent.setup();
		stubApi(routes());
		const opened = await open("/organisation/system-roles");

		await user.click(
			await screen.findByRole("button", { name: "Edit Manager" })
		);

		await waitFor(() => {
			expect(opened.router.state.location.href).toBe(EDITOR);
		});
	});

	it("shows the role as it is, with nothing to save yet", async () => {
		stubApi(routes());
		await open(EDITOR);

		expect(
			await screen.findByRole("heading", { level: 1, name: "Manager" })
		).toBeVisible();
		expect(screen.getByRole("textbox", { name: /Role name/ })).toHaveValue(
			"Manager"
		);
		expect(box("Branches", "View")).toBeChecked();
		expect(box("Branches", "Create")).toBeChecked();
		expect(box("Branches", "Edit")).not.toBeChecked();
		expect(box("Departments", "View")).toBeChecked();
		expect(
			screen.getByText(`3 of ${PERMISSION_KEYS.length} selected`)
		).toBeVisible();
		expect(save()).toBeDisabled();
		expect(
			screen.getByRole("button", { name: "Discard changes" })
		).toBeDisabled();
	});

	it("saves the name and the whole permission set, then returns to the list", async () => {
		const user = userEvent.setup();
		const calls = stubApi(routes());
		const opened = await open(EDITOR);
		const name = await screen.findByRole("textbox", { name: /Role name/ });

		await user.clear(name);
		await user.type(name, "  Area manager ");
		await user.click(box("Departments", "Edit"));
		await user.click(box("Branches", "Create"));

		expect(screen.getByText("1 added, 1 removed")).toBeVisible();
		await user.click(save());

		expect(
			await screen.findByRole("heading", { level: 1, name: "System roles" })
		).toBeVisible();
		expect(opened.router.state.location.pathname).toBe(
			"/organisation/system-roles"
		);
		expect(
			calls.filter((call) => call.method === "PUT").map((call) => call.body)
		).toEqual([
			{
				name: "Area manager",
				permissions: ["branch:read", "department:read", "department:update"],
				status: "ACTIVE",
			},
		]);
		// The role may be one the person holds, so the workspace is asked again.
		await waitFor(() => {
			expect(
				calls.filter((call) => call.path === "/api/v1/me/workspace")
			).toHaveLength(2);
		});
	});

	it("puts back what was loaded when changes are discarded", async () => {
		const user = userEvent.setup();
		const calls = stubApi(routes());
		await open(EDITOR);
		const name = await screen.findByRole("textbox", { name: /Role name/ });

		await user.type(name, " two");
		await user.click(box("Branches", "View"));
		expect(screen.getByText("2 removed")).toBeVisible();
		await user.click(screen.getByRole("button", { name: "Discard changes" }));

		expect(name).toHaveValue("Manager");
		expect(box("Branches", "Create")).toBeChecked();
		expect(save()).toBeDisabled();
		expect(calls.some((call) => call.method === "PUT")).toBe(false);
	});

	it("won't save a role with no permissions and says why", async () => {
		const user = userEvent.setup();
		stubApi(routes());
		await open(EDITOR);
		await screen.findByRole("textbox", { name: /Role name/ });

		await user.click(box("Branches", "View"));
		await user.click(box("Departments", "View"));

		expect(screen.getByText("Choose at least one permission.")).toBeVisible();
		expect(save()).toBeDisabled();
	});

	it("checks the name before asking the API", async () => {
		const user = userEvent.setup();
		const calls = stubApi(routes());
		await open(EDITOR);
		const name = await screen.findByRole("textbox", { name: /Role name/ });

		await user.clear(name);
		await user.type(name, "M");
		await user.click(save());

		expect(await screen.findByText("Use 2 to 100 characters.")).toBeVisible();
		expect(calls.some((call) => call.method === "PUT")).toBe(false);
	});

	it("shows a taken name on the name field and keeps the changes", async () => {
		const user = userEvent.setup();
		stubApi({
			...routes(),
			[SAVE]: problemReply(409, "ACCESS_ROLE_NAME_CONFLICT"),
		});
		const opened = await open(EDITOR);
		const name = await screen.findByRole("textbox", { name: /Role name/ });

		await user.clear(name);
		await user.type(name, "Staff");
		await user.click(save());

		expect(
			await screen.findByText(
				'A role named "Staff" already exists. Choose a different name.'
			)
		).toBeVisible();
		expect(name).toHaveFocus();
		expect(name).toHaveValue("Staff");
		expect(opened.router.state.location.pathname).toBe(ROLE_PAGE);
		expect(screen.queryByText(/API says/)).not.toBeInTheDocument();
	});

	it("explains a save the API refuses for permissions the person doesn't hold", async () => {
		const user = userEvent.setup();
		stubApi({ ...routes(), [SAVE]: problemReply(403, "AUTHORIZATION_DENIED") });
		await open(EDITOR);
		await screen.findByRole("textbox", { name: /Role name/ });

		await user.click(box("Branches", "Edit"));
		await user.click(save());

		expect(await screen.findByRole("alert")).toHaveTextContent(
			"This role includes permissions you don’t hold, or you can no longer change system roles."
		);
		expect(box("Branches", "Edit")).toBeChecked();
	});

	it("saves back untouched any permission this app's catalog doesn't know", async () => {
		const user = userEvent.setup();
		const calls = stubApi({
			...routes([...PERMISSION_KEYS, "leave:approve"]),
			[ROLE]: roleReply({ permissions: ["branch:read", "leave:approve"] }),
		});
		await open(EDITOR);
		await screen.findByRole("textbox", { name: /Role name/ });

		await user.click(box("Branches", "Edit"));
		await user.click(save());

		await waitFor(() => {
			expect(
				calls.filter((call) => call.method === "PUT").map((call) => call.body)
			).toEqual([
				{
					name: "Manager",
					permissions: ["branch:read", "branch:update", "leave:approve"],
					status: "ACTIVE",
				},
			]);
		});
	});
});

describe("System role editor, read-only", () => {
	const expectReadOnly = (): void => {
		expect(screen.getByRole("textbox", { name: /Role name/ })).toBeDisabled();
		for (const item of screen.getAllByRole("checkbox"))
			expect(item).toBeDisabled();
		expect(
			screen.queryByRole("button", { name: "Save changes" })
		).not.toBeInTheDocument();
	};

	it("shows the Company Owner role with every permission and no way to change it", async () => {
		const user = userEvent.setup();
		stubApi({
			...routes(),
			[ROLES]: {
				status: 200,
				body: envelope({
					content: [
						role({
							name: "Company Owner",
							protectedRole: true,
							status: "ACTIVE",
							permissions: PERMISSION_KEYS,
						}),
					],
					page: { totalElements: 1 },
				}),
			},
			[ROLE]: roleReply({
				name: "Company Owner",
				protectedRole: true,
				status: "ACTIVE",
				permissions: PERMISSION_KEYS,
			}),
		});
		await open("/organisation/system-roles");

		await user.click(
			await screen.findByRole("button", {
				name: "More actions for Company Owner",
			})
		);
		// View opens the role on who has it; its permissions are one tab over.
		await user.click(await screen.findByRole("menuitem", { name: "View" }));
		await user.click(await screen.findByRole("tab", { name: "Permissions" }));

		expect(
			await screen.findByText(
				"The Company Owner role always has every permission and can’t be changed."
			)
		).toBeVisible();
		expectReadOnly();
		expect(screen.getByText("Full access")).toBeVisible();
		for (const item of screen.getAllByRole("checkbox"))
			expect(item).toBeChecked();
	});

	it("shows a role holding a permission the person doesn't, since the API would refuse any change", async () => {
		stubApi(routes(["access_role:read", "access_role:update", "branch:read"]));
		await open(EDITOR);

		expect(
			await screen.findByText(
				"This role includes permissions you don’t hold, so you can’t change it."
			)
		).toBeVisible();
		expectReadOnly();
	});

	it("shows the role to someone who may read roles but not change them", async () => {
		stubApi(routes(["access_role:read"]));
		await open(EDITOR);

		expect(
			await screen.findByText(
				"You don’t have permission to change system roles."
			)
		).toBeVisible();
		expectReadOnly();
	});
});

describe("System role editor, role not loaded", () => {
	it.each([
		[
			problemReply(404, "ACCESS_ROLE_NOT_FOUND"),
			"This role doesn’t exist or has been deleted.",
		],
		[
			problemReply(403, "AUTHORIZATION_DENIED"),
			"You don’t have permission to view this role.",
		],
		[
			problemReply(500, "INTERNAL_ERROR"),
			"We couldn’t load this role. Please try again.",
		],
	])("says why and offers the way back", async (reply, message) => {
		stubApi({ ...routes(), [ROLE]: reply });
		await open(EDITOR);

		expect(await screen.findByRole("alert")).toHaveTextContent(message);
		expect(screen.getByRole("link", { name: "System roles" })).toHaveAttribute(
			"href",
			"/organisation/system-roles"
		);
	});
});
