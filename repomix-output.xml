describe("People URL state", () => {
	it("keeps a recognised page, sort and status", () => {
		expect(
			parsePeopleSearch({ page: 3, sort: "jobTitle,desc", status: "INACTIVE" })
		).toEqual({ page: 3, sort: "jobTitle,desc", status: "INACTIVE" });
	});

	it.each([
		{ page: 0 },
		{ page: -2 },
		{ page: 1.5 },
		{ page: "2" },
		{ sort: "email,asc" },
		{ sort: "displayName" },
		{ sort: "displayName,up" },
		{ status: "PENDING" },
		{ status: "active" },
	])("drops what it does not recognise: %o", (search) => {
		expect(parsePeopleSearch(search)).toEqual({});
	});

	it("leaves out the defaults and anything else in the URL", () => {
		expect(
			parsePeopleSearch({ page: 1, sort: "displayName,asc", search: "Moses" })
		).toEqual({});
	});

	it("sorts by name, A to Z, by default", () => {
		expect(sortOf({})).toEqual({ field: "displayName", desc: false });
		expect(sortOf({ sort: "status,desc" })).toEqual({
			field: "status",
			desc: true,
		});
	});

	it("writes a sort, page and status back to the URL, leaving out defaults", () => {
		expect(sortParameter({ field: "department", desc: true })).toBe(
			"department,desc"
		);
		expect(
			sortParameter({ field: "displayName", desc: false })
		).toBeUndefined();
		expect(pageParameter(1)).toBeUndefined();
		expect(pageParameter(4)).toBe(4);
	});

	it("ticks both statuses without a filter and filters only on exactly one", () => {
		expect(statusesOf({})).toEqual(["ACTIVE", "INACTIVE"]);
		expect(statusesOf({ status: "ACTIVE" })).toEqual(["ACTIVE"]);
		expect(statusParameter(["INACTIVE"])).toBe("INACTIVE");
		expect(statusParameter(["ACTIVE", "INACTIVE"])).toBeUndefined();
		expect(statusParameter([])).toBeUndefined();
	});

	it("builds the API query from the URL and the trimmed search text", () => {
		expect(peopleQueryOf({ page: 2, status: "ACTIVE" }, "  moses ")).toEqual({
			page: 2,
			sort: { field: "displayName", desc: false },
			status: "ACTIVE",
			search: "moses",
		});
		expect(peopleQueryOf({}, "")).toEqual({
			page: 1,
			sort: { field: "displayName", desc: false },
			search: "",
		});
	});
});

describe("a person's URL state", () => {
	it("opens the page ready to edit only for edit=true", () => {
		expect(parseProfileSearch({ edit: true })).toEqual({ edit: true });
		expect(parseProfileSearch({})).toEqual({});
		expect(parseProfileSearch({ edit: "true" })).toEqual({});
		expect(parseProfileSearch({ edit: false, page: 2 })).toEqual({});
	});
});
</file>

<file path="src/features/people/peopleSearch.ts">
import { z } from "zod";
import {
	MEMBER_STATUSES,
	PEOPLE_SORT_FIELDS,
	type MemberStatus,
	type PeopleQuery,
	type PeopleSort,
} from "@/features/people/api";

const sortParameterSchema = z.templateLiteral([
	z.enum(PEOPLE_SORT_FIELDS),
	",",
	z.enum(["asc", "desc"]),
]);

/** A sort as the URL carries it, e.g. `jobTitle,desc`, the API's own form. */
export type PeopleSortParameter = z.infer<typeof sortParameterSchema>;

/** People are listed by name, A to Z, unless the URL says otherwise. */
const DEFAULT_SORT_PARAMETER: PeopleSortParameter = "displayName,asc";

const searchSchema = z.object({
	page: z.number().int().min(1).optional().catch(undefined),
	sort: sortParameterSchema.optional().catch(undefined),
	status: z.enum(MEMBER_STATUSES).optional().catch(undefined),
});

/**
 * The People table's state that belongs in the URL, so it survives a reload
 * and can be shared. Each part is left out at its default: the first page,
 * sorted by name, every status. The search text is never here: names
 * typed into it must not land in browser history or logs.
 */
export type PeopleSearch = z.infer<typeof searchSchema>;

/** Reads the URL's table state, dropping anything it does not recognise. */
export const parsePeopleSearch = (
	search: Record<string, unknown>
): PeopleSearch => {
	const { page, sort, status } = searchSchema.parse(search);
	return {
		...(page === undefined || page === 1 ? {} : { page }),
		...(sort === undefined || sort === DEFAULT_SORT_PARAMETER ? {} : { sort }),
		...(status === undefined ? {} : { status }),
	};
};

export const sortOf = ({
	sort = DEFAULT_SORT_PARAMETER,
}: PeopleSearch): PeopleSort => {
	const [field, direction] = sort.split(",") as [PeopleSort["field"], string];
	return { field, desc: direction === "desc" };
};

/** The URL's `sort` for a sort, left out for the default. */
export const sortParameter = ({
	field,
	desc,
}: PeopleSort): PeopleSortParameter | undefined => {
	const parameter: PeopleSortParameter = `${field},${desc ? "desc" : "asc"}`;
	return parameter === DEFAULT_SORT_PARAMETER ? undefined : parameter;
};

/** The URL's `page`, left out for the first. */
export const pageParameter = (page: number): number | undefined =>
	page > 1 ? page : undefined;

/** The statuses ticked in the "Showing" filter: both when the URL names none. */
export const statusesOf = ({ status }: PeopleSearch): Array<MemberStatus> =>
	status ? [status] : [...MEMBER_STATUSES];

/** The URL's `status` for the ticked statuses: both or neither mean no filter. */
export const statusParameter = (
	statuses: ReadonlyArray<MemberStatus>
): MemberStatus | undefined =>
	statuses.length === 1 ? statuses[0] : undefined;

/** The page of people to ask the API for. */
export const peopleQueryOf = (
	search: PeopleSearch,
	text: string
): PeopleQuery => ({
	page: search.page ?? 1,
	sort: sortOf(search),
	...(search.status ? { status: search.status } : {}),
	search: text.trim(),
});

/**
 * A person's page in the URL: `edit` opens it ready to change, so an edit can
 * be linked to from the People list and survives a reload.
 */
export type ProfileSearch = { edit?: true };

/** Reads a person's page's URL state, dropping anything it does not recognise. */
export const parseProfileSearch = (
	search: Record<string, unknown>
): ProfileSearch => (search["edit"] === true ? { edit: true } : {});
</file>

<file path="src/features/people/profileFormSchema.test.ts">
import type { TFunction } from "i18next";
import { describe, expect, it } from "vitest";
import {
	EMPTY_PROFILE,
	profileFormSchema,
	type ProfileFormValues,
} from "@/features/people/profileFormSchema";

// Each message is its own key, so a test reads which rule refused.
const t = ((key: string) => key.replace("people.form.", "")) as TFunction;
const schema = profileFormSchema(t, "2026-10-06");
const valid: ProfileFormValues = {
	...EMPTY_PROFILE,
	displayName: "Priya Nair",
	email: "priya@company.com",
	departmentId: "d-1",
};
/** Each refused field and its message. */
const refusals = (
	changes: Partial<ProfileFormValues>
): Record<string, string> =>
	Object.fromEntries(
		(schema.safeParse({ ...valid, ...changes }).error?.issues ?? []).map(
			(issue) => [issue.path.join("."), issue.message]
		)
	);

describe("profile form rules", () => {
	it("needs only a name, an email address and a department", () => {
		expect(schema.safeParse(valid).success).toBe(true);
		expect(
			refusals({ displayName: "  ", email: "", departmentId: "" })
		).toEqual({
			displayName: "fullNameRequired",
			email: "emailRequired",
			departmentId: "departmentRequired",
		});
	});

	it("trims the name and email address", () => {
		expect(
			schema.parse({
				...valid,
				displayName: "  Priya Nair ",
				email: " priya@company.com ",
			})
		).toMatchObject({ displayName: "Priya Nair", email: "priya@company.com" });
	});

	it.each([
		[{ displayName: "x".repeat(256) }, { displayName: "fullNameLength" }],
		[{ email: "priya" }, { email: "emailInvalid" }],
		[{ email: `${"x".repeat(310)}@company.com` }, { email: "emailLength" }],
	])("refuses %j", (changes, expected) => {
		expect(refusals(changes)).toEqual(expected);
	});

	it("accepts a date of birth only in the past", () => {
		expect(refusals({ dateOfBirth: "2026-10-05" })).toEqual({});
		expect(refusals({ dateOfBirth: "2026-10-06" })).toEqual({
			dateOfBirth: "dateOfBirthPast",
		});
	});

	it.each([
		["", {}],
		["+6581234567", {}],
		["81234567", { phone: "phoneCountry" }],
		["+65123", { phone: "phoneInvalid" }],
		["+0123456789", { phone: "phoneInvalid" }],
		[`+65${"1".repeat(14)}`, { phone: "phoneInvalid" }],
	])("reads the phone %j", (phone, expected) => {
		expect(refusals({ phone })).toEqual(expected);
	});

	it("needs the probation to end on or after the hire date", () => {
		expect(
			refusals({ hireDate: "2026-10-01", probationEndDate: "2026-10-01" })
		).toEqual({});
		expect(refusals({ probationEndDate: "2026-01-01" })).toEqual({});
		expect(
			refusals({ hireDate: "2026-10-01", probationEndDate: "2026-09-30" })
		).toEqual({ probationEndDate: "probationBeforeHire" });
	});

	it("checks the probation even while another field is wrong", () => {
		expect(
			refusals({
				displayName: "",
				hireDate: "2026-10-01",
				probationEndDate: "2026-09-30",
			})
		).toEqual({
			displayName: "fullNameRequired",
			probationEndDate: "probationBeforeHire",
		});
	});
});

describe("profile status rule", () => {
	it("accepts only the statuses the API knows", () => {
		expect(refusals({ status: "INACTIVE" })).toEqual({});
		expect(Object.keys(refusals({ status: "PENDING" as "ACTIVE" }))).toEqual([
			"status",
		]);
	});
});
</file>

<file path="src/features/people/profileFormSchema.ts">
import type { TFunction } from "i18next";
import { z } from "zod";
import { todayDate, type IsoDate } from "@/components/forms/Calendar";
import {
	companyMemberSchema,
	type CompanyMember,
} from "@/features/organisation/api";
import {
	EMPLOYMENT_TYPES,
	MEMBER_STATUSES,
	type EmploymentType,
	type MemberStatus,
} from "@/features/people/api";

/** The API's phone rule: "+", then 7 to 15 digits, the first not 0. */
export const E164_PATTERN = /^\+[1-9]\d{6,14}$/;

const key = "people.form";

/**
 * A person's profile as the form holds it. Optional fields are `""` (or
 * `null` for the manager) while empty; dates are ISO `YYYY-MM-DD`.
 */
export type ProfileFormValues = {
	displayName: string;
	dateOfBirth: string;
	/** E.164, or bare digits until a country code is chosen. */
	phone: string;
	email: string;
	employmentType: EmploymentType | "";
	hireDate: string;
	probationEndDate: string;
	jobTitleId: string;
	departmentId: string;
	/** The person's manager; the API calls it who they report to. */
	reportsTo: CompanyMember | null;
	/** A system role to assign in the Department once the person is added. */
	accessRoleId: string;
	/** Edited on an existing person only; a new person is always active. */
	status?: MemberStatus;
};

/**
 * Mirrors the API's rules for a person's profile so most mistakes are caught
 * before a request. `today` decides which dates are in the past.
 */
export const profileFormSchema = (
	t: TFunction,
	today: IsoDate = todayDate(Date.now())
): z.ZodType<ProfileFormValues, ProfileFormValues> => {
	const dates = z.object({
		hireDate: z.string(),
		probationEndDate: z.string(),
	});
	return z
		.object({
			displayName: z
				.string()
				.trim()
				.min(1, t(`${key}.fullNameRequired`))
				.max(255, t(`${key}.fullNameLength`)),
			dateOfBirth: z
				.string()
				.refine(
					(value) => value === "" || value < today,
					t(`${key}.dateOfBirthPast`)
				),
			phone: z
				.string()
				// Without a country, the field reports bare digits.
				.refine(
					(value) => value === "" || value.startsWith("+"),
					t(`${key}.phoneCountry`)
				)
				.refine(
					(value) =>
						value === "" || !value.startsWith("+") || E164_PATTERN.test(value),
					t(`${key}.phoneInvalid`)
				),
			email: z
				.string()
				.trim()
				.min(1, t(`${key}.emailRequired`))
				.max(320, t(`${key}.emailLength`))
				.pipe(z.email(t(`${key}.emailInvalid`))),
			employmentType: z.union([z.enum(EMPLOYMENT_TYPES), z.literal("")]),
			hireDate: z.string(),
			probationEndDate: z.string(),
			jobTitleId: z.string(),
			departmentId: z.string().min(1, t(`${key}.departmentRequired`)),
			reportsTo: companyMemberSchema.nullable(),
			accessRoleId: z.string(),
			status: z.enum(MEMBER_STATUSES).optional(),
		})
		.refine(
			({ hireDate, probationEndDate }) =>
				hireDate === "" ||
				probationEndDate === "" ||
				probationEndDate >= hireDate,
			{
				path: ["probationEndDate"],
				message: t(`${key}.probationBeforeHire`),
				// Checked even while another field is wrong, so every mistake shows at once.
				when: (payload) => dates.safeParse(payload.value).success,
			}
		);
};

/** A profile with nothing filled in yet. */
export const EMPTY_PROFILE: ProfileFormValues = {
	displayName: "",
	dateOfBirth: "",
	phone: "",
	email: "",
	employmentType: "",
	hireDate: "",
	probationEndDate: "",
	jobTitleId: "",
	departmentId: "",
	reportsTo: null,
	accessRoleId: "",
};
</file>

<file path="src/features/people/profileRefusal.ts">
import type { TFunction } from "i18next";
import { ApiProblemError } from "@/common/problem";
import { mapRefusal, type Refusal } from "@/features/organisation/refusal";

/** The profile fields a refusal can land on, in the order they are shown. */
export const PROFILE_FIELDS = [
	"displayName",
	"dateOfBirth",
	"phone",
	"email",
	"employmentType",
	"hireDate",
	"probationEndDate",
	"status",
	"jobTitleId",
	"departmentId",
	"reportsTo",
] as const;

export type ProfileField = (typeof PROFILE_FIELDS)[number];

/**
 * The refusals of a change to an existing person, as `"<status> <errorCode>"`.
 * Every code an edit or a status change can be refused with is named here
 * once, so a code the API settles on differently is a one-line change.
 */
export const PROFILE_REFUSAL_CODES = {
	/** The name belongs to a login the person also uses in another company. */
	identityShared: "409 IDENTITY_SHARED_ACROSS_COMPANIES",
	selfDeactivation: "409 CANNOT_DEACTIVATE_SELF",
	ownerDeactivation: "409 COMPANY_OWNER_CANNOT_BE_DEACTIVATED",
	/** The person was chosen as their own manager. */
	reportsToSelf: "400 REPORTS_TO_SELF",
	/** An inactive person can't be moved to another Department while they stay inactive. */
	inactiveMove: "400 INVALID_DEPARTMENT_MEMBER",
	/** Moving or deactivating them would leave their Department without a head. */
	lastDepartmentHead: "409 LAST_ACTIVE_DEPARTMENT_HEAD",
	/** Nobody, or nobody the person may see. */
	profileNotFound: "404 MEMBER_PROFILE_NOT_FOUND",
	/** They were moved to another Department since their profile was loaded. */
	profileMoved: "409 MEMBER_PROFILE_MOVED",
	rateLimited: "429 RATE_LIMITED",
} as const;

const codes = PROFILE_REFUSAL_CODES;

/** What else an edit's refusal is read against; left out when adding a person. */
export type EditContext = {
	/** A 403 then means the new Department is one the person may not move people to. */
	departmentChanged: boolean;
};

/**
 * Server codes select frontend-owned copy; untrusted server prose is never
 * displayed. Given `edit`, the refusals of a change to an existing person
 * are read too, and the general copy speaks of saving rather than adding.
 */
export const profileRefusal = (
	error: unknown,
	t: TFunction,
	edit?: EditContext
): Refusal<ProfileField> => {
	const key = "people.form";
	const field = (name: ProfileField, message: string) =>
		({ field: name, message }) as const;
	if (
		edit?.departmentChanged &&
		error instanceof ApiProblemError &&
		error.status === 403
	)
		return {
			fields: { departmentId: t(`${key}.departmentForbidden`) },
			refreshMembers: false,
		};
	const department = field("departmentId", t(`${key}.departmentUnavailable`));
	const jobTitle = field("jobTitleId", t(`${key}.jobTitleUnavailable`));
	const rejected = t(`${key}.rejected`);
	const lastHead = t(`${key}.lastDepartmentHead`);
	return mapRefusal<ProfileField>(error, {
		codes: {
			"409 MEMBER_EMAIL_ALREADY_REGISTERED": field(
				"email",
				t(`${key}.emailTaken`)
			),
			// The chosen department, job title or manager changed since the lists loaded.
			"404 DEPARTMENT_NOT_FOUND": department,
			"404 BRANCH_NOT_FOUND": department,
			"409 DEPARTMENT_INACTIVE": department,
			"404 JOB_TITLE_NOT_FOUND": jobTitle,
			"409 JOB_TITLE_INACTIVE": jobTitle,
			"404 REPORTS_TO_NOT_FOUND": {
				...field("reportsTo", t(`${key}.managerUnavailable`)),
				refreshMembers: true,
			},
			...(edit && {
				[codes.identityShared]: field(
					"displayName",
					t(`${key}.identityShared`)
				),
				[codes.selfDeactivation]: field("status", t(`${key}.selfDeactivation`)),
				[codes.ownerDeactivation]: field(
					"status",
					t(`${key}.ownerDeactivation`)
				),
				[codes.reportsToSelf]: field("reportsTo", t(`${key}.managerSelf`)),
				[codes.inactiveMove]: field("departmentId", t(`${key}.inactiveMove`)),
				...(edit.departmentChanged && {
					[codes.lastDepartmentHead]: field("departmentId", lastHead),
				}),
			}),
		},
		alerts: {
			"400 IDENTITY_REJECTED": t(`${key}.identityRejected`),
			[codes.rateLimited]: t("auth.retryHold.later"),
			...(edit && {
				[codes.lastDepartmentHead]: lastHead,
				[codes.profileNotFound]: t(`${key}.profileMissing`),
				[codes.profileMoved]: t("people.profile.moved"),
			}),
		},
		// A 400 names the request's fields; the manager is `reportsToMembershipId` there.
		fieldErrors: {
			displayName: field("displayName", rejected),
			dateOfBirth: field("dateOfBirth", t(`${key}.dateOfBirthPast`)),
			phone: field("phone", t(`${key}.phoneInvalid`)),
			email: field("email", t(`${key}.emailInvalid`)),
			employmentType: field("employmentType", rejected),
			hireDate: field("hireDate", rejected),
			probationEndDate: field(
				"probationEndDate",
				t(`${key}.probationBeforeHire`)
			),
			jobTitleId: field("jobTitleId", rejected),
			reportsToMembershipId: field("reportsTo", rejected),
			...(edit && {
				status: field("status", rejected),
				departmentId: field("departmentId", rejected),
			}),
		},
		forbidden: t(edit ? `${key}.forbiddenSave` : `${key}.forbiddenSubmit`),
		failed: t(edit ? `${key}.saveFailed` : `${key}.failed`),
	});
};

/**
 * Why deactivating or reactivating a person was refused, for the dialog
 * that asked. Never the API's own text.
 */
export const profileActionRefusal = (error: unknown, t: TFunction): string =>
	mapRefusal<never>(error, {
		alerts: {
			[codes.selfDeactivation]: t("people.form.selfDeactivation"),
			[codes.ownerDeactivation]: t("people.form.ownerDeactivation"),
			[codes.lastDepartmentHead]: t("people.form.lastDepartmentHead"),
			[codes.profileNotFound]: t("people.form.profileMissing"),
			[codes.profileMoved]: t("people.profile.moved"),
			[codes.rateLimited]: t("auth.retryHold.later"),
		},
		forbidden: t("people.profile.actionForbidden"),
		failed: t("people.profile.actionFailed"),
	}).message ?? t("people.profile.actionFailed");
</file>

