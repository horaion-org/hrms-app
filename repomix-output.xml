import { render, screen, within } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { I18nextProvider } from "react-i18next";
import { describe, expect, it, vi } from "vitest";
import { authTestI18n } from "@/features/auth/testingI18n";
import { AssignAccessRoleDialog } from "@/features/organisation/AssignAccessRoleDialog";

const people = [
	{ membershipId: "m-1", displayName: "Marcus Lim", status: "ACTIVE" as const },
	{ membershipId: "m-2", displayName: "Priya Nair", status: "ACTIVE" as const },
];
const targets = [
	{ label: "Whole company" },
	{ label: "Orchard", branchId: "b-1" },
	{ label: "Orchard › Kitchen", branchId: "b-1", departmentId: "d-1" },
];

const roles = [
	{
		accessRoleId: "r-1",
		name: "Manager",
		protectedRole: false,
		status: "ACTIVE" as const,
		permissions: ["branch:read", "department:read"],
		holderCount: 0,
	},
	{
		accessRoleId: "r-2",
		name: "Supervisor",
		protectedRole: false,
		status: "ACTIVE" as const,
		permissions: ["audit_event:read"],
		holderCount: 0,
	},
];

describe("AssignAccessRoleDialog", () => {
	it("shows what the chosen role allows and assigns it to a person at several places", async () => {
		const user = userEvent.setup();
		const onAssign = vi.fn();
		render(
			<I18nextProvider i18n={authTestI18n}>
				<AssignAccessRoleDialog
					people={people}
					query=""
					roles={roles}
					targets={targets}
					onAssign={onAssign}
					onClose={vi.fn()}
					onQueryChange={vi.fn()}
				/>
			</I18nextProvider>
		);
		const dialog = await screen.findByRole("dialog", { name: "Assign role" });
		const submit = screen.getByRole("button", { name: "Assign role" });

		// Nothing is promised until a role is chosen.
		expect(dialog).not.toHaveTextContent("There, they will be able to");
		await user.click(screen.getByRole("button", { name: "Role" }));
		await user.click(await screen.findByRole("option", { name: "Manager" }));

		expect(dialog).toHaveTextContent("There, they will be able to");
		expect(screen.getAllByRole("term").map((term) => term.textContent)).toEqual(
			["Branches", "Departments"]
		);
		expect(submit).toBeDisabled();

		await user.click(screen.getByLabelText("Person"));
		await user.click(await screen.findByRole("option", { name: "Priya Nair" }));
		expect(submit).toBeDisabled();
		await user.click(screen.getByLabelText("Applies to"));
		await user.click(await screen.findByRole("option", { name: "Orchard" }));
		await user.click(
			await screen.findByRole("option", { name: "Orchard › Kitchen" })
		);
		await user.keyboard("{Escape}");
		await user.click(submit);

		expect(onAssign).toHaveBeenCalledWith("r-1", "m-2", [
			targets[1],
			targets[2],
		]);
	});

	it("edits where a person has the role, starting from the places they hold it", async () => {
		const user = userEvent.setup();
		const onAssign = vi.fn();
		render(
			<I18nextProvider i18n={authTestI18n}>
				<AssignAccessRoleDialog
					editing={{ person: people[1]!, places: [targets[1]!] }}
					people={[]}
					query=""
					roles={[roles[0]!]}
					targets={targets}
					onAssign={onAssign}
					onClose={vi.fn()}
					onQueryChange={vi.fn()}
				/>
			</I18nextProvider>
		);
		const dialog = await screen.findByRole("dialog", {
			name: "Edit assignment",
		});

		// The person is fixed; only the places change.
		expect(within(dialog).getByLabelText("Person")).toBeDisabled();
		expect(dialog).toHaveTextContent("Priya Nair");
		await user.click(
			within(dialog).getByRole("button", { name: "Remove Orchard" })
		);
		expect(dialog).toHaveTextContent(
			"Saving with no places removes this role from Priya Nair."
		);
		await user.click(screen.getByRole("button", { name: "Save changes" }));

		expect(onAssign).toHaveBeenCalledWith("r-1", "m-2", []);
	});
});
</file>

<file path="src/features/organisation/AssignAccessRoleDialog/AssignAccessRoleDialog.tsx">
import { useId, useState } from "react";
import { useTranslation } from "react-i18next";
import type { FunctionComponent } from "@/common/types";
import { Combobox } from "@/components/forms/Combobox";
import { FormRow, formRowIds } from "@/components/forms/FormRow";
import { Select } from "@/components/forms/Select";
import { Button } from "@/components/ui/Button";
import { Dialog } from "@/components/ui/Dialog";
import type { AccessRole, CompanyMember } from "@/features/organisation/api";
import {
	placeKey,
	type AssignmentTarget,
} from "@/features/organisation/assignmentTargets";
import { PermissionSummary } from "@/features/organisation/PermissionSummary";
import { isPermissionKey } from "@/features/workspace/permissionKeys";

export type AssignAccessRoleDialogProps = {
	/** The roles that can be assigned. Given just one, it is the role and no choice is offered. */
	roles: Array<AccessRole>;
	/** The people matching `query`. */
	people: Array<CompanyMember>;
	query: string;
	onQueryChange: (query: string) => void;
	/** Every place a role can apply, widest first. */
	targets: Array<AssignmentTarget>;
	/**
	 * Set to change where one person already has the role: the person is
	 * fixed and the form starts from the places they hold it.
	 */
	editing?: { person: CompanyMember; places: Array<AssignmentTarget> };
	/** Why the last attempt was refused. */
	error?: string;
	/** True while an attempt is being sent. */
	submitting?: boolean;
	onAssign: (
		accessRoleId: string,
		membershipId: string,
		targets: Array<AssignmentTarget>
	) => void;
	onClose: () => void;
};

const key = "organisation.accessRoles.assignments.dialog";

/**
 * Gives one access role to one person at one or several places, or changes
 * the places a person already has it, showing what the role allows so it is
 * clear what is being given.
 */
export const AssignAccessRoleDialog = ({
	roles,
	people,
	query,
	onQueryChange,
	targets,
	editing,
	error,
	submitting = false,
	onAssign,
	onClose,
}: AssignAccessRoleDialogProps): FunctionComponent => {
	const { t } = useTranslation();
	const roleId = useId();
	const personId = useId();
	const placesId = useId();
	const onlyRole = roles.length === 1 ? roles[0] : undefined;
	// Empty until a role is chosen, which keeps the Select controlled throughout.
	const [chosenRoleId, setChosenRoleId] = useState(
		onlyRole?.accessRoleId ?? ""
	);
	const [person, setPerson] = useState<CompanyMember | null>(
		editing?.person ?? null
	);
	const [places, setPlaces] = useState<Array<AssignmentTarget>>(
		editing?.places ?? []
	);
	const [placeQuery, setPlaceQuery] = useState("");
	const role = roles.find((item) => item.accessRoleId === chosenRoleId);

	return (
		<Dialog
			open
			description={t(editing ? `${key}.editDescription` : `${key}.description`)}
			preventClose={submitting}
			title={t(editing ? `${key}.editTitle` : `${key}.title`)}
			footer={
				<div className="flex justify-end gap-3">
					<Button disabled={submitting} variant="secondary" onClick={onClose}>
						{t(`${key}.cancel`)}
					</Button>
					<Button
						// Editing may clear every place, which removes the role from the person.
						disabled={!role || !person || (!editing && places.length === 0)}
						loading={submitting}
						onClick={() => {
							if (role && person)
								onAssign(role.accessRoleId, person.membershipId, places);
						}}
					>
						{t(editing ? `${key}.editSubmit` : `${key}.submit`)}
					</Button>
				</div>
			}
			onClose={onClose}
		>
			<div className="space-y-6">
				{error && (
					<p className="text-sm text-error-700" role="alert">
						{error}
					</p>
				)}
				<FormRow
					required
					htmlFor={roleId}
					label={t(`${key}.role`)}
					layout="stacked"
				>
					<Select
						aria-labelledby={formRowIds(roleId).labelId}
						className="w-full"
						disabled={submitting || onlyRole !== undefined}
						placeholder={t(`${key}.rolePlaceholder`)}
						value={chosenRoleId}
						options={roles.map((item) => ({
							value: item.accessRoleId,
							label: item.name,
						}))}
						onChange={setChosenRoleId}
					/>
				</FormRow>
				<FormRow
					required
					htmlFor={personId}
					label={t(`${key}.person`)}
					layout="stacked"
				>
					<Combobox
						aria-required
						aria-label={t(`${key}.person`)}
						disabled={submitting || editing !== undefined}
						emptyText={t(`${key}.noResults`)}
						getKey={(member) => member.membershipId}
						getLabel={(member) => member.displayName}
						id={personId}
						multiple={false}
						options={people}
						placeholder={t(`${key}.personPlaceholder`)}
						query={query}
						searchPlaceholder={t(`${key}.searchPlaceholder`)}
						value={person}
						onChange={setPerson}
						onQueryChange={onQueryChange}
					/>
				</FormRow>
				<FormRow
					required
					hint={t(`${key}.placesHint`)}
					htmlFor={placesId}
					label={t(`${key}.places`)}
					layout="stacked"
				>
					<Combobox
						aria-required
						aria-describedby={formRowIds(placesId).hintId}
						aria-label={t(`${key}.places`)}
						disabled={submitting}
						emptyText={t(`${key}.placesEmpty`)}
						getKey={placeKey}
						getLabel={(target) => target.label}
						id={placesId}
						placeholder={t(`${key}.placesPlaceholder`)}
						query={placeQuery}
						searchPlaceholder={t(`${key}.placesSearch`)}
						value={places}
						options={targets.filter((target) =>
							target.label
								.toLocaleLowerCase()
								.includes(placeQuery.trim().toLocaleLowerCase())
						)}
						onChange={setPlaces}
						onQueryChange={setPlaceQuery}
					/>
				</FormRow>
				{editing && places.length === 0 && (
					<p className="text-sm font-semibold text-error-700">
						{t(`${key}.removesAll`, { name: editing.person.displayName })}
					</p>
				)}
				{role && (
					<PermissionSummary
						permissions={role.permissions.filter(isPermissionKey)}
						title={t(`${key}.allows`)}
					/>
				)}
			</div>
		</Dialog>
	);
};
