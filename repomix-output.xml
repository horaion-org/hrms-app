<file path="src/features/people/profileRequest.ts">
import type {
	CreateMemberProfileBody,
	MemberProfileDetail,
	MemberStatus,
	UpdateMemberProfileBody,
} from "@/features/people/api";
import type { ProfileFormValues } from "@/features/people/profileFormSchema";

/**
 * The create request for a filled-in profile. Fields left empty are left out,
 * never sent as "", which the API rejects. The Department goes in the URL and
 * a system role is assigned separately, so neither is part of the body.
 */
export const profileRequest = ({
	displayName,
	email,
	jobTitleId,
	reportsTo,
	dateOfBirth,
	phone,
	employmentType,
	hireDate,
	probationEndDate,
}: ProfileFormValues): CreateMemberProfileBody => ({
	displayName: displayName.trim(),
	email: email.trim(),
	...(jobTitleId && { jobTitleId }),
	...(reportsTo && { reportsToMembershipId: reportsTo.membershipId }),
	...(dateOfBirth && { dateOfBirth }),
	...(phone && { phone }),
	...(employmentType && { employmentType }),
	...(hireDate && { hireDate }),
	...(probationEndDate && { probationEndDate }),
});

/** A profile as the form holds it, with the status it is saved with. */
export type ProfileEditValues = ProfileFormValues & { status: MemberStatus };

/**
 * The update request for an edited profile. `PUT` replaces the profile, so
 * every field is sent and an empty one is null, never "". The login email
 * is not changed here and a system role is assigned separately, so neither
 * is part of the body.
 */
export const profileUpdateRequest = ({
	displayName,
	status,
	departmentId,
	jobTitleId,
	reportsTo,
	dateOfBirth,
	phone,
	employmentType,
	hireDate,
	probationEndDate,
}: ProfileEditValues): UpdateMemberProfileBody => ({
	displayName: displayName.trim(),
	status,
	departmentId,
	jobTitleId: jobTitleId || null,
	reportsToMembershipId: reportsTo?.membershipId ?? null,
	dateOfBirth: dateOfBirth || null,
	phone: phone || null,
	employmentType: employmentType || null,
	hireDate: hireDate || null,
	probationEndDate: probationEndDate || null,
});

/**
 * A saved profile as the form starts from it, with the system role it holds
 * in its Department, if any.
 */
export const profileEditValues = (
	profile: MemberProfileDetail,
	accessRoleId = ""
): ProfileEditValues => ({
	displayName: profile.displayName,
	dateOfBirth: profile.dateOfBirth ?? "",
	phone: profile.phone ?? "",
	email: profile.email,
	employmentType: profile.employmentType ?? "",
	hireDate: profile.hireDate ?? "",
	probationEndDate: profile.probationEndDate ?? "",
	jobTitleId: profile.jobTitleId ?? "",
	departmentId: profile.departmentId ?? "",
	// Only an active member can be chosen as a manager, so the current one is shown as one.
	reportsTo: profile.reportsTo && { ...profile.reportsTo, status: "ACTIVE" },
	accessRoleId,
	status: profile.status,
});
</file>

<file path="src/features/people/storyCompany.tsx">
import type { QueryClient } from "@tanstack/react-query";
import {
	createMemoryHistory,
	createRootRoute,
	createRoute,
	createRouter,
	RouterProvider,
} from "@tanstack/react-router";
import type { Decorator } from "@storybook/react-vite";
import { workspaceQuery } from "@/features/workspace/api";

/**
 * Renders a story inside the current company, holding the `permissions`
 * parameter's keys company-wide, for components that ask `useCan` or read
 * the current company from the `/_authenticated` route, as the app's pages
 * do. List it before `storyProviders` so the query client wraps it.
 */
export const storyCompany =
	(client: QueryClient, companyId: string): Decorator =>
	(Story, { parameters }) => {
		const permissions: unknown = parameters["permissions"];
		client.setQueryData(workspaceQuery.queryKey, {
			companies: [
				{
					uuid: companyId,
					name: "Story company",
					permissions: Array.isArray(permissions)
						? permissions.filter((key) => typeof key === "string")
						: [],
					branches: [],
				},
			],
		});
		const root = createRootRoute();
		const authenticated = createRoute({
			getParentRoute: () => root,
			id: "_authenticated",
			beforeLoad: () => ({
				currentCompany: {
					kind: "settled",
					company: { companyId, membershipId: "story-member" },
				},
			}),
		});
		const index = createRoute({
			getParentRoute: () => authenticated,
			path: "/",
			component: Story,
		});
		return (
			<RouterProvider
				router={createRouter({
					routeTree: root.addChildren([authenticated.addChildren([index])]),
					history: createMemoryHistory({ initialEntries: ["/"] }),
					defaultPendingMinMs: 0,
				})}
			/>
		);
	};
</file>

<file path="src/features/people/useAddEmployee.ts">
import { useMutation, useQueryClient } from "@tanstack/react-query";
import { useNavigate } from "@tanstack/react-router";
import { useChangeAccessRoleHolders } from "@/features/organisation/useAccessRoleHolders";
import {
	createMemberProfile,
	type CreateMemberProfileBody,
	type MemberProfilePlace,
} from "@/features/people/api";
import { withPeopleNotice } from "@/features/people/peopleNoticeState";
import type { ProfileFormValues } from "@/features/people/profileFormSchema";
import { profileRequest } from "@/features/people/profileRequest";

/**
 * Adds a person, then gives them the chosen system role in their Department,
 * then returns to the People list with a notice saying so. A refused create
 * rejects for the form to explain. A refused role does not: the person
 * exists, so the list says they were added and the role still needs assigning.
 */
export const useAddEmployee = (
	companyId: string
): ((
	values: ProfileFormValues,
	place: MemberProfilePlace
) => Promise<void>) => {
	const client = useQueryClient();
	const navigate = useNavigate();
	const create = useMutation({
		mutationFn: ({
			place,
			body,
		}: {
			place: MemberProfilePlace;
			body: CreateMemberProfileBody;
		}) => createMemberProfile(companyId, place, body),
		onSuccess: () =>
			Promise.all([
				client.invalidateQueries({ queryKey: ["people", companyId] }),
				client.invalidateQueries({
					queryKey: ["organisation", companyId, "members"],
				}),
			]),
	});
	const assign = useChangeAccessRoleHolders(companyId);
	return async (values, place) => {
		const person = await create.mutateAsync({
			place,
			body: profileRequest(values),
		});
		let roleNotAssigned = false;
		if (values.accessRoleId)
			try {
				await assign.mutateAsync({
					grants: [
						{
							companyMembershipId: person.membershipId,
							accessRoleId: values.accessRoleId,
							...place,
						},
					],
				});
			} catch {
				roleNotAssigned = true;
			}
		await navigate({
			to: "/people",
			state: withPeopleNotice({
				kind: "added",
				name: person.displayName,
				roleNotAssigned,
			}),
		});
	};
};
</file>

<file path="src/features/people/usePeople.ts">
import { useQuery } from "@tanstack/react-query";
import { useEffect, useState } from "react";
import { ApiProblemError } from "@/common/problem";
import type { ListPage } from "@/features/organisation/api";
import {
	peopleQuery,
	type MemberProfile,
	type PeopleQuery,
} from "@/features/people/api";
import { workspaceQuery } from "@/features/workspace/api";
import { PEOPLE_READ_KEYS } from "@/features/workspace/permissionKeys";
import { retry } from "@/features/workspace/retry";
import { useCanAnywhere } from "@/features/workspace/useCan";

/**
 * One page of the People list. `hidden` when the person's grants don't reach
 * it anywhere, whether the workspace says so up front or the API refuses
 * with a 403. The API returns only the people in units where the key is
 * held, so the rows are never trimmed here.
 */
export type PeopleList =
	| { status: "pending" | "error" | "hidden" }
	| ({ status: "ready" } & ListPage<MemberProfile>);

export const usePeople = (
	companyId: string,
	query: PeopleQuery
): PeopleList => {
	const workspace = useQuery({ ...workspaceQuery, retry });
	const allowed = useCanAnywhere()(PEOPLE_READ_KEYS);
	const list = useQuery(peopleQuery(companyId, query, allowed));

	if (workspace.isPending) return { status: "pending" };
	if (workspace.isError) return { status: "error" };
	if (!allowed) return { status: "hidden" };
	if (list.error instanceof ApiProblemError && list.error.status === 403)
		return { status: "hidden" };
	if (list.isError) return { status: "error" };
	if (list.data === undefined) return { status: "pending" };
	return { status: "ready", ...list.data };
};

/** The search text once typing pauses, so each keystroke is not its own request. */
export const useSettledSearch = (text: string): string => {
	const [settled, setSettled] = useState(text.trim());
	useEffect(() => {
		const timeout = setTimeout(() => {
			setSettled(text.trim());
		}, 250);
		return (): void => {
			clearTimeout(timeout);
		};
	}, [text]);
	return settled;
};
</file>

