	employeeCode: "EMP-10392",
	displayName: "Kent Chua",
	email: "kent.chua@company.com",
	phone: "+6583247931",
	branchId: "b-1",
	branchName: "Orchard",
	departmentId: "d-1",
	departmentName: "Food & Beverage",
	jobTitleId: "j-1",
	jobTitleName: "Pastry chef",
	status: "ACTIVE",
	dateOfBirth: "1987-03-22",
	employmentType: "FULL_TIME",
