<file path="src/features/people/useSkills.ts">
import {
	keepPreviousData,
	useMutation,
	useQuery,
	useQueryClient,
	type UseMutationResult,
	type UseQueryResult,
} from "@tanstack/react-query";
import { useMemo, useState } from "react";
import type { ListPage } from "@/features/organisation/api";
import {
	memberSkillsQuery,
	replaceMemberSkills,
	searchCompanySkills,
	type CompanySkill,
	type MemberSkill,
	type SkillValue,
} from "@/features/people/api";
import { sameSkills } from "@/features/people/skills";
import { retry } from "@/features/workspace/retry";
import { useDebouncedValue } from "@/hooks/useDebouncedValue";

/** A person's skills. */
export const useMemberSkills = (
	companyId: string,
	membershipId: string
): UseQueryResult<Array<MemberSkill>> =>
	useQuery(memberSkillsQuery(companyId, membershipId));

/** Replaces a person's skills with the complete new set, and keeps what the API saved. */
export const useReplaceSkills = (
	companyId: string,
	membershipId: string
): UseMutationResult<Array<MemberSkill>, Error, ReadonlyArray<SkillValue>> => {
	const client = useQueryClient();
	return useMutation({
		mutationFn: (skills) =>
			replaceMemberSkills(companyId, membershipId, skills),
		onSuccess: (saved) => {
			client.setQueryData(
				memberSkillsQuery(companyId, membershipId).queryKey,
				saved
			);
		},
	});
};

/**
 * The company's skill names matching what is typed, asked for once typing
 * pauses, keeping the current names on screen while the next ones load.
 */
export const useSkillSuggestions = (
	companyId: string,
	query: string
): UseQueryResult<ListPage<CompanySkill>> => {
	const search = useDebouncedValue(query.trim(), 250);
	return useQuery({
		queryKey: ["people", companyId, "skills", search] as const,
		queryFn: () => searchCompanySkills(companyId, search),
		placeholderData: keepPreviousData,
		retry,
	});
};

/** A person's skills as changed on the page, held until the page saves them. */
export type SkillsDraft = {
	skills: ReadonlyArray<SkillValue>;
	onChange: (skills: Array<SkillValue>) => void;
	/** Whether they differ from the skills as loaded. */
	changed: boolean;
};

/** Holds changes to `loaded`, the skills as the API has them, until saved or discarded. */
export const useSkillsDraft = (
	loaded: ReadonlyArray<MemberSkill> | undefined
): SkillsDraft => {
	const [edited, setEdited] = useState<Array<SkillValue>>();
	const initial = useMemo(
		() =>
			(loaded ?? []).map(({ name, proficiency }) => ({ name, proficiency })),
		[loaded]
	);
	const skills = edited ?? initial;
	return {
		skills,
		onChange: setEdited,
		changed: edited !== undefined && !sameSkills(edited, loaded ?? []),
	};
};
</file>

<file path="src/pages/PersonProfile.tsx">
import { useSuspenseQuery } from "@tanstack/react-query";
import {
	getRouteApi,
	useRouterState,
	type ErrorComponentProps,
} from "@tanstack/react-router";
import { useTranslation } from "react-i18next";
import { ApiProblemError } from "@/common/problem";
import type { FunctionComponent } from "@/common/types";
import { Button } from "@/components/ui/Button";
import { ArrowLeftIcon, EditIcon } from "@/components/ui/Icon";
import {
	useCurrentCompanyId,
	useCurrentMembershipId,
} from "@/features/organisation/useCurrentCompanyId";
import { memberProfileQuery } from "@/features/people/api";
import { describeMemberRoles } from "@/features/people/memberRoles";
import { PeopleNotice } from "@/features/people/PeopleNotice";
import { peopleNoticeFrom } from "@/features/people/peopleNoticeState";
import { ProfileDetails } from "@/features/people/ProfileDetails";
import { profileEditAccess } from "@/features/people/profileEditAccess";
import { ProfileHeader } from "@/features/people/ProfileHeader";
import { ProfileMenu } from "@/features/people/ProfileMenu";
import { ProfileNotesAndSkills } from "@/features/people/ProfileNotesAndSkills";
import { useMemberRoles } from "@/features/people/useMemberRoles";
import { useCan } from "@/features/workspace/useCan";
import { PersonProfileEdit } from "@/pages/PersonProfileEdit";

const route = getRouteApi("/_authenticated/_app/people_/$membershipId");

const BackToPeople = (): FunctionComponent => {
	const { t } = useTranslation();
	return (
		<Button leadingIcon={<ArrowLeftIcon />} to="/people" variant="textlink">
			{t("people.profile.back")}
		</Button>
	);
};

/**
 * One person's profile, read-only, or ready to change with `?edit=true` for
 * someone who may. Who may change it comes from where the profile is
 * filed: see `profileEditAccess`. A change just made is confirmed above the
 * profile.
 */
export const PersonProfile = (): FunctionComponent => {
	const { membershipId } = route.useParams();
	const { edit } = route.useSearch();
	const companyId = useCurrentCompanyId();
	const self = useCurrentMembershipId() === membershipId;
	const { t } = useTranslation();
	const can = useCan();
	const { data: profile } = useSuspenseQuery(
		memberProfileQuery(companyId, membershipId)
	);
	const access = profileEditAccess(profile, can);
	const roles = useMemberRoles(companyId, membershipId);
	const notice = peopleNoticeFrom(
		useRouterState({ select: (state) => state.location.state })
	);

	return (
		<>
			<BackToPeople />
			{notice && <PeopleNotice className="mt-6" notice={notice} />}
			<div className="mt-8">
				{edit && access ? (
					<PersonProfileEdit profile={profile} roles={roles} />
				) : (
					<>
						<ProfileHeader
							profile={profile}
							actions={
								<>
									{access && (
										<Button
											leadingIcon={<EditIcon />}
											params={{ membershipId }}
											search={{ edit: true }}
											to="/people/$membershipId"
											variant="secondary"
										>
											{t("people.profile.edit")}
										</Button>
									)}
									{access && (
										<ProfileMenu
											companyId={companyId}
											profile={profile}
											self={self}
										/>
									)}
								</>
							}
						/>
						<ProfileDetails
							className="mt-10"
							profile={profile}
							systemRoles={describeMemberRoles(roles, t)}
						/>
						<ProfileNotesAndSkills
							className="mt-6"
							companyId={companyId}
							noteActions="menu"
							profile={profile}
							skillsChangeable={access}
						/>
					</>
				)}
			</div>
		</>
	);
};

/**
 * Nobody (404), someone outside the units where the person may read
 * profiles (403), and a malformed id (400) all read the same, so the page
 * never says which it was.
 */
const isMissing = (error: unknown): boolean =>
	error instanceof ApiProblemError &&
	(error.status === 404 || error.status === 403 || error.status === 400);

/** Shown in place of the profile when it can't be loaded. */
export const PersonProfileProblem = ({
	error,
}: ErrorComponentProps): FunctionComponent => {
	const { t } = useTranslation();
	return (
		<>
			<BackToPeople />
			<p className="mt-8 text-sm text-error-700" role="alert">
				{t(
					isMissing(error)
						? "people.profile.missing"
						: "people.profile.loadFailed"
				)}
			</p>
		</>
	);
};
</file>

