		expect(await screen.findByRole("alert")).toHaveTextContent(
			en.auth.retryHold.later
		);
		expect(screen.getByRole("button", { name: copy.submit })).toBeEnabled();
		expect(screen.getByRole("button", { name: copy.resend })).toBeEnabled();
	}
);
